rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasAll(['ho_ten','email','so_dien_thoai','dia_chi','anh_dai_dien','vai_tro','la_gia_su','trang_thai','created_at','updated_at'])
          && d.keys().hasOnly(['ho_ten','email','so_dien_thoai','dia_chi','anh_dai_dien','vai_tro','la_gia_su','trang_thai','cap_hoc','tuoi','lop','khu_vuc','muc_tieu_hoc_tap','created_at','updated_at'])
          && d.ho_ten is string && d.ho_ten.size() >= 2 && d.ho_ten.size() <= 100
          && d.email is string && d.email == request.auth.token.email
          && d.so_dien_thoai is string && d.so_dien_thoai.matches('0[35789][0-9]{8}')
          && d.dia_chi is string && d.dia_chi.size() <= 255
          && d.get('cap_hoc','') is string && d.get('cap_hoc','').size() <= 80
          && (!('tuoi' in d) || (d.tuoi is int && d.tuoi >= 5 && d.tuoi <= 100))
          && d.get('lop','') is string && d.get('lop','').size() <= 40
          && d.get('khu_vuc','') is string && d.get('khu_vuc','').size() <= 120
          && d.get('muc_tieu_hoc_tap','') is string && d.get('muc_tieu_hoc_tap','').size() <= 500
          && d.anh_dai_dien is string && d.anh_dai_dien.size() <= 90000
          && d.updated_at == request.time;
      }
      allow get: if owner();
      allow list, delete: if false;
      allow create: if owner() && validProfile()
        && request.resource.data.vai_tro == 'STUDENT'
        && request.resource.data.la_gia_su == false
        && request.resource.data.trang_thai == 'ACTIVE'
        && request.resource.data.created_at == request.time;
      allow update: if owner() && resource.data.trang_thai == 'ACTIVE' && validProfile()
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ho_ten','so_dien_thoai','dia_chi','anh_dai_dien','cap_hoc','tuoi','lop','khu_vuc','muc_tieu_hoc_tap','updated_at'])
          || (resource.data.la_gia_su == false && request.resource.data.la_gia_su == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ho_ten','so_dien_thoai','la_gia_su','updated_at'])
            && getAfter(/databases/$(database)/documents/tutor_profiles/$(userId)).data.trang_thai_xac_minh == 'PENDING'
            && getAfter(/databases/$(database)/documents/tutor_profiles/$(userId)).data.created_at == request.time));
    }
    // Display images only. Private names/contact details remain in the existing profile collections.
    match /profile_avatars/{userId} {
      allow get: if signedIn() || verifiedTutor(userId);
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['anh_dai_dien','updated_at'])
        && request.resource.data.keys().hasOnly(['anh_dai_dien','updated_at'])
        && request.resource.data.anh_dai_dien is string && request.resource.data.anh_dai_dien.size() <= 90000
        && request.resource.data.updated_at == request.time
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.trang_thai == 'ACTIVE'
        && request.resource.data.anh_dai_dien == getAfter(/databases/$(database)/documents/users/$(userId)).data.anh_dai_dien;
    }
    // Only trusted administrators publish catalog records. Private contacts stay in users.
    match /subjects/{subjectId} {
      allow read: if resource.data.dang_su_dung == true;
      allow write: if false;
    }
    match /tutor_profiles/{tutorId} {
      function validRegistration(){
        let d=request.resource.data;
        return d.keys().hasAll(['user_id','ho_ten','hoc_van','truong','chuyen_nganh','gioi_thieu','khu_vuc','so_nam_kinh_nghiem','hinh_thuc_day','nhan_lop','trang_thai_xac_minh','created_at','updated_at'])
          && d.keys().hasOnly(['user_id','ho_ten','hoc_van','truong','chuyen_nganh','gioi_thieu','khu_vuc','so_nam_kinh_nghiem','hinh_thuc_day','nhan_lop','trang_thai_xac_minh','created_at','updated_at'])
          && d.user_id == tutorId && d.ho_ten is string && d.ho_ten.size() >= 2 && d.ho_ten.size() <= 100
          && d.hoc_van is string && d.hoc_van.size() <= 100 && d.truong is string && d.truong.size() <= 150
          && d.chuyen_nganh is string && d.chuyen_nganh.size() <= 150 && d.gioi_thieu is string && d.gioi_thieu.size() <= 2000
          && d.khu_vuc is string && d.khu_vuc.size() <= 150
          && d.so_nam_kinh_nghiem is int && d.so_nam_kinh_nghiem >= 0 && d.so_nam_kinh_nghiem <= 60
          && d.hinh_thuc_day in ['TRUC_TUYEN','TAI_NHA','CA_HAI'] && d.nhan_lop == true
          && d.trang_thai_xac_minh == 'PENDING' && d.created_at == request.time && d.updated_at == request.time;
      }
      allow get: if (request.auth != null && request.auth.uid == tutorId) || admin() || resource.data.trang_thai_xac_minh == 'VERIFIED';
      allow list: if admin() || resource.data.trang_thai_xac_minh == 'VERIFIED';
      allow create: if signedIn() && request.auth.uid == tutorId && account().trang_thai == 'ACTIVE'
        && account().la_gia_su == false && validRegistration()
        && getAfter(/databases/$(database)/documents/tutor_applications/$(tutorId)).data.created_at == request.time
        && getAfter(/databases/$(database)/documents/tutor_applications/$(tutorId)).data.trang_thai_xac_minh == 'PENDING'
        && getAfter(/databases/$(database)/documents/users/$(tutorId)).data.la_gia_su == true
        && getAfter(/databases/$(database)/documents/users/$(tutorId)).data.ho_ten == request.resource.data.ho_ten;
      allow update: if stamped() && (
        (admin() && resource.data.trang_thai_xac_minh in ['PENDING','IN_REVIEW']
          && request.resource.data.trang_thai_xac_minh in ['IN_REVIEW','VERIFIED','NEEDS_REVISION','REJECTED']
          && changed(['trang_thai_xac_minh','updated_at'])
          && getAfter(/databases/$(database)/documents/tutor_applications/$(tutorId)).data.trang_thai_xac_minh == request.resource.data.trang_thai_xac_minh
          && getAfter(/databases/$(database)/documents/tutor_applications/$(tutorId)).data.nguoi_duyet_id == request.auth.uid
          && getAfter(/databases/$(database)/documents/tutor_applications/$(tutorId)).data.reviewed_at == request.time)
        || (signedIn() && request.auth.uid == tutorId && account().trang_thai == 'ACTIVE'
          && resource.data.trang_thai_xac_minh == 'NEEDS_REVISION' && request.resource.data.trang_thai_xac_minh == 'PENDING'
          && changed(['trang_thai_xac_minh','truong','chuyen_nganh','updated_at'])
          && request.resource.data.truong is string && request.resource.data.truong.size() <= 150
          && request.resource.data.chuyen_nganh is string && request.resource.data.chuyen_nganh.size() <= 150
          && getAfter(/databases/$(database)/documents/tutor_applications/$(tutorId)).data.trang_thai_xac_minh == 'PENDING'
          && getAfter(/databases/$(database)/documents/tutor_applications/$(tutorId)).data.submitted_at == request.time));
      allow delete: if false;
    }
    // Application evidence is private; never store it in the public tutor catalog.
    match /tutor_applications/{uid} {
      function evidence(f) {
        let image = get(/databases/$(database)/documents/tutor_applications/$(uid)/evidence_images/$(f.path.split('/')[3])).data;
        return f is map && f.keys().hasAll(['name','path','type','size','kind'])
          && f.keys().hasOnly(['name','path','type','size','kind'])
          && f.name is string && f.name.size() > 0 && f.name.size() <= 150
          && f.path is string && f.path.matches('tutor_applications/' + uid + '/evidence_images/[a-zA-Z0-9-]+')
          && f.type == 'image/jpeg'
          && f.size is int && f.size > 0 && f.size <= 307200 && f.kind in ['diploma','certificate']
          && image.user_id == uid && image.name == f.name
          && image.type == f.type && image.size == f.size && image.kind == f.kind;
      }
      function validEvidence() {
        let d=request.resource.data;let f=d.minh_chung;
        return d.user_id == uid && d.truong is string && d.truong.size() > 0 && d.truong.size() <= 150
          && d.chuyen_nganh is string && d.chuyen_nganh.size() > 0 && d.chuyen_nganh.size() <= 150
          && d.ghi_chu is string && d.ghi_chu.size() <= 500 && f is list && f.size() >= 1 && f.size() <= 4
          && evidence(f[0]) && (f.size() < 2 || evidence(f[1])) && (f.size() < 3 || evidence(f[2])) && (f.size() < 4 || evidence(f[3]))
          && (f[0].kind == 'diploma' || (f.size() >= 2 && f[1].kind == 'diploma') || (f.size() >= 3 && f[2].kind == 'diploma') || (f.size() == 4 && f[3].kind == 'diploma'));
      }
      function imageForApproval(){
        let f=request.resource.data.get('minh_chung',[]);
        return f is list && f.size() > 0 && (
          (f[0].kind == 'diploma' && evidence(f[0]))
          || (f.size() > 1 && f[1].kind == 'diploma' && evidence(f[1]))
          || (f.size() > 2 && f[2].kind == 'diploma' && evidence(f[2]))
          || (f.size() > 3 && f[3].kind == 'diploma' && evidence(f[3])));
      }
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if (signedIn() && request.auth.uid == uid && account().trang_thai == 'ACTIVE' && validEvidence()
          && request.resource.data.keys().hasOnly(['user_id','ho_ten','truong','chuyen_nganh','ghi_chu','minh_chung','mon_hoc','cap_lop','hoc_phi','trang_thai_xac_minh','submitted_at','created_at','updated_at'])
          && request.resource.data.ho_ten is string && request.resource.data.ho_ten.size() <= 100
          && request.resource.data.mon_hoc is string && request.resource.data.mon_hoc.size() <= 150
          && request.resource.data.cap_lop is string && request.resource.data.cap_lop.size() <= 150
          && request.resource.data.hoc_phi is int && request.resource.data.hoc_phi >= 50000 && request.resource.data.hoc_phi <= 2000000
          && request.resource.data.trang_thai_xac_minh == 'PENDING' && stamped()
          && request.resource.data.created_at == request.time && request.resource.data.submitted_at == request.time
          && getAfter(/databases/$(database)/documents/tutor_profiles/$(uid)).data.trang_thai_xac_minh == 'PENDING')
        || (admin() && stamped() && request.resource.data.user_id == uid
          && request.resource.data.nguoi_duyet_id == request.auth.uid && request.resource.data.reviewed_at == request.time
          && request.resource.data.keys().hasOnly(['user_id','ho_ten','created_at','updated_at','reviewed_at','nguoi_duyet_id','ly_do','trang_thai_xac_minh'])
          && request.resource.data.ly_do is string && request.resource.data.ly_do.size() <= 500
          && request.resource.data.trang_thai_xac_minh != 'VERIFIED'
          && (request.resource.data.trang_thai_xac_minh == 'IN_REVIEW' || request.resource.data.ly_do.size() > 0)
          && request.resource.data.trang_thai_xac_minh == getAfter(/databases/$(database)/documents/tutor_profiles/$(uid)).data.trang_thai_xac_minh);
      allow update: if stamped() && request.resource.data.user_id == uid && (
        (admin() && resource.data.trang_thai_xac_minh in ['PENDING','IN_REVIEW']
          && changed(['trang_thai_xac_minh','nguoi_duyet_id','reviewed_at','ly_do','updated_at'])
          && request.resource.data.trang_thai_xac_minh in ['IN_REVIEW','VERIFIED','NEEDS_REVISION','REJECTED']
          && (request.resource.data.trang_thai_xac_minh != 'VERIFIED' || imageForApproval())
          && request.resource.data.nguoi_duyet_id == request.auth.uid && request.resource.data.reviewed_at == request.time
          && request.resource.data.ly_do is string && request.resource.data.ly_do.size() <= 500
          && (request.resource.data.trang_thai_xac_minh in ['VERIFIED','IN_REVIEW'] || request.resource.data.ly_do.size() > 0)
          && request.resource.data.trang_thai_xac_minh == getAfter(/databases/$(database)/documents/tutor_profiles/$(uid)).data.trang_thai_xac_minh)
        || (signedIn() && request.auth.uid == uid && account().trang_thai == 'ACTIVE' && validEvidence()
          && resource.data.trang_thai_xac_minh == 'NEEDS_REVISION' && request.resource.data.trang_thai_xac_minh == 'PENDING'
          && changed(['truong','chuyen_nganh','ghi_chu','minh_chung','trang_thai_xac_minh','submitted_at','updated_at'])
          && request.resource.data.submitted_at == request.time
          && getAfter(/databases/$(database)/documents/tutor_profiles/$(uid)).data.trang_thai_xac_minh == 'PENDING'));
      allow delete: if false;
      // One compressed image per document; the parent application contains metadata only.
      match /evidence_images/{imageId} {
        function ownerCanUpload() {
          return signedIn() && request.auth.uid == uid && account().trang_thai == 'ACTIVE'
            && ((!exists(/databases/$(database)/documents/tutor_profiles/$(uid)) && account().la_gia_su == false)
              || get(/databases/$(database)/documents/tutor_profiles/$(uid)).data.trang_thai_xac_minh == 'NEEDS_REVISION');
        }
        allow get: if signedIn() && account().trang_thai == 'ACTIVE' && (request.auth.uid == uid || admin());
        allow list: if false;
        allow create: if ownerCanUpload() && imageId.matches('[a-zA-Z0-9-]+')
          && request.resource.data.keys().hasAll(['user_id','name','type','size','kind','anh','created_at'])
          && request.resource.data.keys().hasOnly(['user_id','name','type','size','kind','anh','created_at'])
          && request.resource.data.user_id == uid
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 150
          && request.resource.data.type == 'image/jpeg' && request.resource.data.kind in ['diploma','certificate']
          && request.resource.data.anh is bytes && request.resource.data.anh.size() > 0 && request.resource.data.anh.size() <= 307200
          && request.resource.data.size is int && request.resource.data.size == request.resource.data.anh.size()
          && request.resource.data.created_at == request.time;
        allow update, delete: if false;
      }
    }
    match /tutor_subjects/{offeringId} {
      allow read: if true;
      allow create: if signedIn() && account().trang_thai == 'ACTIVE'
        && request.resource.data.keys().hasAll(['tutor_id','subject_id','cap_lop','hoc_phi_moi_buoi'])
        && request.resource.data.keys().hasOnly(['tutor_id','subject_id','cap_lop','hoc_phi_moi_buoi'])
        && request.resource.data.tutor_id == request.auth.uid
        && request.resource.data.subject_id is string && request.resource.data.subject_id.size() <= 150
        && request.resource.data.cap_lop in ['TIEU_HOC','THCS','THPT','LUYEN_THI','KHAC']
        && offeringId == request.auth.uid + '_' + request.resource.data.subject_id + '_' + request.resource.data.cap_lop
        && request.resource.data.hoc_phi_moi_buoi is int && request.resource.data.hoc_phi_moi_buoi >= 50000 && request.resource.data.hoc_phi_moi_buoi <= 2000000
        && get(/databases/$(database)/documents/subjects/$(request.resource.data.subject_id)).data.dang_su_dung == true
        && getAfter(/databases/$(database)/documents/tutor_profiles/$(request.auth.uid)).data.trang_thai_xac_minh == 'PENDING'
        && getAfter(/databases/$(database)/documents/tutor_profiles/$(request.auth.uid)).data.created_at == request.time;
      allow update, delete: if false;
    }
    // UC11 / UC12: only the active owner manages a request; deleted records retain applications.
    match /tutor_requests/{requestId} {
      function activeAccount() {
        return signedIn() && account().trang_thai == 'ACTIVE';
      }
      function owner() {
        return resource.data.student_id == request.auth.uid;
      }
      function ownRequestId() {
        let suffix = requestId.replace('^.*_', '');
        return requestId == request.auth.uid + '_' + suffix
          && suffix.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}');
      }
      function nonblank(value, maximum) {
        return value is string && value.trim().size() > 0 && value.size() <= maximum;
      }
      function validSubject(data) {
        let subject = get(/databases/$(database)/documents/subjects/$(data.subject_id)).data;
        return subject.dang_su_dung == true && subject.ten_mon == data.mon_hoc;
      }
      function validRequest() {
        let d = request.resource.data;
        let keys = ['student_id','ten_hoc_vien','tieu_de','subject_id','mon_hoc','cap_hoc',
          'ngan_sach','lich_hoc','mo_ta','trang_thai','created_at','updated_at'];
        return d.keys().hasAll(keys) && d.keys().hasOnly(keys.concat(['deleted_at']))
          && d.student_id is string && nonblank(d.ten_hoc_vien, 100)
          && nonblank(d.tieu_de, 120) && nonblank(d.subject_id, 150) && nonblank(d.mon_hoc, 100)
          && d.cap_hoc in ['TIEU_HOC','THCS','THPT','LUYEN_THI','KHAC']
          && d.ngan_sach is int && d.ngan_sach >= 1 && d.ngan_sach <= 10000000
          && nonblank(d.lich_hoc, 300) && nonblank(d.mo_ta, 2000)
          && d.created_at is timestamp && d.updated_at == request.time
          && d.trang_thai in ['OPEN','CLOSED','DELETED']
          && ((d.trang_thai == 'DELETED' && d.deleted_at == request.time)
            || (d.trang_thai != 'DELETED' && !('deleted_at' in d)));
      }
      function edited() {
        let d = request.resource.data;
        return resource.data.trang_thai in ['OPEN','CLOSED']
          && d.trang_thai == resource.data.trang_thai
          && changed(['tieu_de','subject_id','mon_hoc','cap_hoc','ngan_sach','lich_hoc','mo_ta','updated_at'])
          && ((d.subject_id == resource.data.subject_id && d.mon_hoc == resource.data.mon_hoc)
            || validSubject(d));
      }
      function closed() {
        return resource.data.trang_thai == 'OPEN' && request.resource.data.trang_thai == 'CLOSED'
          && changed(['trang_thai','updated_at']);
      }
      function removed() {
        return resource.data.trang_thai in ['OPEN','CLOSED'] && request.resource.data.trang_thai == 'DELETED'
          && changed(['trang_thai','deleted_at','updated_at']);
      }
      // An owner's missing deterministic ID is readable for the UC11 idempotent transaction.
      allow get: if activeAccount() && ((resource == null && ownRequestId())
        || (resource != null && (owner() || (resource.data.trang_thai == 'OPEN' && verifiedTutor(request.auth.uid)))));
      allow list: if activeAccount()
        && (owner() || (resource.data.trang_thai == 'OPEN' && verifiedTutor(request.auth.uid)));
      allow create: if activeAccount() && ownRequestId() && validRequest()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.ten_hoc_vien == account().ho_ten
        && request.resource.data.trang_thai == 'OPEN'
        && request.resource.data.created_at == request.time && validSubject(request.resource.data);
      allow update: if activeAccount() && owner() && validRequest() && (edited() || closed() || removed());
      allow delete: if false;

      match /applications/{tutorId} {
        function parentRequest() {
          return get(/databases/$(database)/documents/tutor_requests/$(requestId)).data;
        }
        function visibleParent() {
          return exists(/databases/$(database)/documents/tutor_requests/$(requestId))
            && parentRequest().trang_thai in ['OPEN','CLOSED'];
        }
        function validApplication() {
          let d = request.resource.data;
          return d.keys().hasAll(['tutor_id','ten_gia_su','gioi_thieu','trang_thai','created_at','updated_at'])
            && d.keys().hasOnly(['tutor_id','ten_gia_su','gioi_thieu','trang_thai','created_at','updated_at'])
            && tutorId == request.auth.uid && d.tutor_id == request.auth.uid
            && d.ten_gia_su == get(/databases/$(database)/documents/tutor_profiles/$(request.auth.uid)).data.ho_ten
            && nonblank(d.ten_gia_su, 100) && nonblank(d.gioi_thieu, 2000)
            && d.trang_thai == 'PENDING' && d.created_at == request.time && d.updated_at == request.time;
        }
        allow read: if activeAccount() && visibleParent()
          && (parentRequest().student_id == request.auth.uid
            || (tutorId == request.auth.uid && resource.data.tutor_id == request.auth.uid));
        allow create: if activeAccount() && visibleParent() && verifiedTutor(request.auth.uid)
          && parentRequest().trang_thai == 'OPEN' && parentRequest().student_id != request.auth.uid
          && validApplication();
        // UC12 opens the applicant list. Application decisions belong to a separate use case.
        allow update, delete: if false;
      }
    }
    // Lessons, group classes and class registrations (member 3).
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && account().vai_tro == 'ADMIN' && account().trang_thai == 'ACTIVE'; }
    // UC21: tài khoản bị khóa (users/{uid}.trang_thai == 'BANNED') không tạo được hội thoại, tin nhắn.
    function notBanned() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.trang_thai != 'BANNED');
    }
    function stamped() { return request.resource.data.updated_at == request.time; }
    function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function account() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function verifiedTutor(uid) {
      return exists(/databases/$(database)/documents/tutor_profiles/$(uid))
        && get(/databases/$(database)/documents/tutor_profiles/$(uid)).data.trang_thai_xac_minh == 'VERIFIED';
    }
    match /lessons/{lessonId} {
      function validLesson() {
        let d = request.resource.data;
        let keys = ['tutor_id','ten_gia_su','student_id','ten_hoc_vien','tieu_de','bat_dau','thoi_luong','hinh_thuc','dia_chi','muc_tieu',
          'hoc_thu','hoc_phi','trang_thai','da_hoan_thanh','noi_dung','ly_do_huy','doi_lich_bat_dau','doi_lich_ly_do','created_at','updated_at'];
        let link = d.get('link_phong_hoc', '');
        return d.keys().hasOnly(keys.concat(['link_phong_hoc', 'doi_lich_phan_hoi'])) && d.keys().hasAll(keys)
          && link is string && link.size() <= 300 && (link == '' || link.matches('(?i)https?://.+'))
          && d.get('doi_lich_phan_hoi', '') in ['', 'DONG_Y', 'GIU_LICH']
          && d.tutor_id is string && d.student_id is string && d.tutor_id != d.student_id
          && d.ten_gia_su is string && d.ten_gia_su.size() <= 100 && d.ten_hoc_vien is string && d.ten_hoc_vien.size() <= 100
          && d.tieu_de is string && d.tieu_de.size() <= 100
          && d.bat_dau is timestamp && d.thoi_luong is int && d.thoi_luong >= 30 && d.thoi_luong % 15 == 0 && d.thoi_luong <= 1440
          && d.hinh_thuc in ['Trực tuyến', 'Tại nhà']
          && d.dia_chi is string && d.dia_chi.size() <= 255 && d.muc_tieu is string && d.muc_tieu.size() > 0 && d.muc_tieu.size() <= 300
          && d.hoc_thu is bool && d.hoc_phi is int && d.hoc_phi >= 0 && d.hoc_phi <= 50000000
          && d.trang_thai in ['PENDING', 'CONFIRMED', 'CANCELLED', 'REJECTED'] && d.da_hoan_thanh is bool
          && d.noi_dung is string && d.noi_dung.size() <= 500 && d.ly_do_huy is string && d.ly_do_huy.size() <= 150
          && (d.doi_lich_bat_dau == null || d.doi_lich_bat_dau is timestamp) && d.doi_lich_ly_do is string && d.doi_lich_ly_do.size() <= 120
          && stamped();
      }
      function lessonChanged(keys) {
        return changed(keys.concat(['link_phong_hoc', 'doi_lich_phan_hoi']))
          && request.resource.data.get('link_phong_hoc', '') == resource.data.get('link_phong_hoc', '')
          && (keys.hasAny(['doi_lich_phan_hoi'])
            || request.resource.data.get('doi_lich_phan_hoi', '') == resource.data.get('doi_lich_phan_hoi', ''));
      }
      function requested() {
        let d = request.resource.data;
        return d.student_id == request.auth.uid && d.ten_hoc_vien == account().ho_ten
          && verifiedTutor(d.tutor_id) && d.ten_gia_su == get(/databases/$(database)/documents/tutor_profiles/$(d.tutor_id)).data.ho_ten
          && d.trang_thai == 'PENDING' && d.da_hoan_thanh == false && d.noi_dung == '' && d.ly_do_huy == ''
          && d.doi_lich_bat_dau == null && d.doi_lich_ly_do == '' && d.get('link_phong_hoc', '') == '' && d.get('doi_lich_phan_hoi', '') == ''
          && d.bat_dau > request.time && d.created_at == request.time
          && (!d.hoc_thu || (d.hoc_phi == 50000 && d.thoi_luong in [30, 45] && d.hinh_thuc == 'Trực tuyến'));
      }
      function answered() {
        let d = request.resource.data;
        return resource.data.tutor_id == request.auth.uid && resource.data.trang_thai == 'PENDING'
          && d.trang_thai in ['CONFIRMED', 'REJECTED'] && lessonChanged(['trang_thai', 'updated_at'])
          && (d.trang_thai == 'REJECTED' || resource.data.bat_dau > request.time);
      }
      function proposed() {
        let d = request.resource.data;
        return resource.data.tutor_id == request.auth.uid && resource.data.trang_thai == 'CONFIRMED'
          && resource.data.doi_lich_bat_dau == null && resource.data.bat_dau > request.time
          && d.doi_lich_bat_dau is timestamp && d.doi_lich_bat_dau > request.time && d.doi_lich_bat_dau != resource.data.bat_dau
          && d.doi_lich_ly_do.size() > 0 && d.get('doi_lich_phan_hoi', '') == ''
          && lessonChanged(['doi_lich_bat_dau', 'doi_lich_ly_do', 'doi_lich_phan_hoi', 'updated_at']);
      }
      function cancelled() {
        let d = request.resource.data;
        return resource.data.student_id == request.auth.uid && resource.data.trang_thai in ['PENDING', 'CONFIRMED']
          && resource.data.bat_dau > request.time && d.trang_thai == 'CANCELLED' && d.ly_do_huy.size() > 0 && d.doi_lich_bat_dau == null
          && lessonChanged(['trang_thai', 'ly_do_huy', 'doi_lich_bat_dau', 'doi_lich_ly_do', 'updated_at']);
      }
      function moved() {
        let d = request.resource.data;
        return resource.data.student_id == request.auth.uid && resource.data.trang_thai == 'CONFIRMED'
          && resource.data.doi_lich_bat_dau != null && resource.data.doi_lich_bat_dau > request.time
          && d.bat_dau == resource.data.doi_lich_bat_dau && d.doi_lich_bat_dau == null
          && d.get('doi_lich_phan_hoi', '') == 'DONG_Y'
          && lessonChanged(['bat_dau', 'doi_lich_bat_dau', 'doi_lich_ly_do', 'doi_lich_phan_hoi', 'updated_at']);
      }
      function kept() {
        return resource.data.student_id == request.auth.uid && resource.data.doi_lich_bat_dau != null
          && request.resource.data.doi_lich_bat_dau == null && request.resource.data.get('doi_lich_phan_hoi', '') == 'GIU_LICH'
          && lessonChanged(['doi_lich_bat_dau', 'doi_lich_ly_do', 'doi_lich_phan_hoi', 'updated_at']);
      }
      function finished() {
        return resource.data.student_id == request.auth.uid && resource.data.trang_thai == 'CONFIRMED'
          && resource.data.da_hoan_thanh == false && request.resource.data.da_hoan_thanh == true
          && request.time >= resource.data.bat_dau + duration.value(resource.data.thoi_luong, 'm')
          && lessonChanged(['da_hoan_thanh', 'updated_at']);
      }
      function linked() {
        return resource.data.tutor_id == request.auth.uid && resource.data.trang_thai == 'CONFIRMED'
          && resource.data.hinh_thuc == 'Trực tuyến'
          && request.time < resource.data.bat_dau + duration.value(resource.data.thoi_luong, 'm')
          && changed(['link_phong_hoc', 'updated_at']);
      }
      allow read: if signedIn() && (resource.data.student_id == request.auth.uid || resource.data.tutor_id == request.auth.uid);
      allow create: if signedIn() && validLesson() && requested();
      allow update: if signedIn() && validLesson() && (answered() || proposed() || cancelled() || moved() || kept() || finished() || linked());
    }
    match /group_classes/{classId} {
      function validClass() {
        let d = request.resource.data;
        let keys = ['tutor_id','ten_gia_su','ten_lop','mon_hoc','cap_hoc','hinh_thuc','dia_chi','mo_ta','ngay_bat_dau','thu','gio','thoi_luong',
          'so_buoi','hoc_phi','tinh_theo_buoi','suc_chua','thanh_vien','trang_thai','hinh_minh_hoa','created_at','updated_at'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys) && d.tutor_id == request.auth.uid
          && d.ten_gia_su is string && d.ten_gia_su.size() <= 100
          && d.ten_lop is string && d.ten_lop.size() > 0 && d.ten_lop.size() <= 60
          && d.mon_hoc is string && d.mon_hoc.size() > 0 && d.mon_hoc.size() <= 50 && d.cap_hoc is string && d.cap_hoc.size() <= 40
          && d.hinh_thuc in ['Trực tuyến', 'Tại nhà'] && d.dia_chi is string && d.dia_chi.size() <= 120
          && (d.hinh_thuc == 'Trực tuyến' || d.dia_chi.size() > 0)
          && d.mo_ta is string && d.mo_ta.size() > 0 && d.mo_ta.size() <= 200
          && d.ngay_bat_dau is string && d.ngay_bat_dau.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.thu is list && d.thu.size() >= 1 && d.thu.size() <= 7
          && d.gio is int && d.gio >= 0 && d.gio <= 23
          && d.thoi_luong is int && d.thoi_luong >= 30 && d.thoi_luong % 30 == 0 && d.gio * 60 + d.thoi_luong <= 1440
          && d.so_buoi is int && d.so_buoi >= 1 && d.so_buoi <= 12
          && d.hoc_phi is int && d.hoc_phi >= 50000 && d.hoc_phi <= 10000000 && d.tinh_theo_buoi is bool
          && d.suc_chua is int && d.suc_chua >= 2 && d.suc_chua <= 10 && d.thanh_vien is list && d.thanh_vien.size() <= d.suc_chua
          && d.trang_thai in ['OPEN', 'RUNNING', 'ENDED'] && d.hinh_minh_hoa is int
          && stamped();
      }
      allow read: if true;
      allow create: if signedIn() && validClass() && verifiedTutor(request.auth.uid)
        && request.resource.data.trang_thai == 'OPEN' && request.resource.data.thanh_vien.size() == 0
        && request.resource.data.created_at == request.time;
      allow update: if signedIn() && validClass() && resource.data.tutor_id == request.auth.uid && resource.data.trang_thai != 'ENDED'
        && !('created_at' in request.resource.data.diff(resource.data).affectedKeys())
        && (request.resource.data.trang_thai == resource.data.trang_thai || resource.data.trang_thai == 'OPEN'
          || request.resource.data.trang_thai == 'ENDED')
        && request.resource.data.thanh_vien.hasAll(resource.data.thanh_vien);
    }
    match /class_registrations/{registrationId} {
      function validRegistration() {
        let d = request.resource.data;
        let keys = ['class_id','tutor_id','student_id','ten_hoc_vien','muc_tieu','ngay_gui','trang_thai','created_at','updated_at'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys) && registrationId == d.class_id + '_' + d.student_id
          && d.ten_hoc_vien is string && d.ten_hoc_vien.size() <= 100
          && d.muc_tieu is string && d.muc_tieu.size() > 0 && d.muc_tieu.size() <= 200
          && d.ngay_gui is string && d.ngay_gui.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.trang_thai in ['PENDING', 'CONFIRMED', 'REJECTED'] && stamped();
      }
      function applied() {
        let d = request.resource.data;
        let c = get(/databases/$(database)/documents/group_classes/$(d.class_id)).data;
        return d.student_id == request.auth.uid && d.ten_hoc_vien == account().ho_ten && d.trang_thai == 'PENDING'
          && d.tutor_id == c.tutor_id && c.tutor_id != request.auth.uid && c.trang_thai == 'OPEN'
          && c.thanh_vien.size() < c.suc_chua && !(request.auth.uid in c.thanh_vien);
      }
      function reviewed() {
        let d = request.resource.data;
        return resource.data.tutor_id == request.auth.uid && resource.data.trang_thai == 'PENDING'
          && d.trang_thai in ['CONFIRMED', 'REJECTED'] && changed(['trang_thai', 'updated_at'])
          && (d.trang_thai == 'REJECTED'
            || d.student_id in getAfter(/databases/$(database)/documents/group_classes/$(d.class_id)).data.thanh_vien);
      }
      allow read: if signedIn() && (resource.data.student_id == request.auth.uid || resource.data.tutor_id == request.auth.uid);
      allow create: if signedIn() && validRegistration() && applied() && request.resource.data.created_at == request.time;
      allow update: if signedIn() && validRegistration()
        && ((applied() && resource.data.trang_thai == 'REJECTED' && changed(['ten_hoc_vien', 'muc_tieu', 'ngay_gui', 'trang_thai', 'updated_at']))
          || reviewed());
    }

    // ---------------------------------------------------------------------------------------------
    // UC21 – Trao đổi qua tin nhắn (màn 05, 06). Chỉ thành viên hội thoại đọc/ghi; tin nhắn không sửa, không xóa.
    // Mã hội thoại = uidA + '__' + uidB (đã sắp xếp); một bên phải là gia sư (tutor_profiles/{uid}).
    // ---------------------------------------------------------------------------------------------
    match /conversations/{conversationId} {
      function isMember(data) { return request.auth != null && data.member_ids is list && request.auth.uid in data.member_ids; }
      function peerOf(data) { return data.member_ids[0] == request.auth.uid ? data.member_ids[1] : data.member_ids[0]; }
      function isTutor(uid) { return exists(/databases/$(database)/documents/tutor_profiles/$(uid)); }
      function validMember(m) {
        return m is map && m.keys().hasOnly(['ho_ten','vai_tro'])
          && m.ho_ten is string && m.ho_ten.size() <= 100
          && m.vai_tro in ['STUDENT','TUTOR',''];
      }
      function validLesson(l) {
        return l is map && l.keys().hasOnly(['title','time','status'])
          && l.title is string && l.title.size() <= 120
          && l.time is string && l.time.size() <= 60
          && l.status is string && l.status.size() <= 40;
      }
      function validNew(d) {
        return d.keys().hasAll(['member_ids','members','last_message','last_sender_id','unread_count','read_at','created_by','created_at','updated_at'])
          && d.keys().hasOnly(['member_ids','members','last_message','last_sender_id','last_message_at','unread_count','read_at','lesson','created_by','created_at','updated_at'])
          && d.member_ids is list && d.member_ids.size() == 2
          && d.member_ids[0] is string && d.member_ids[1] is string && d.member_ids[0] < d.member_ids[1]
          && request.auth.uid in d.member_ids
          && conversationId == d.member_ids[0] + '__' + d.member_ids[1]
          && (isTutor(d.member_ids[0]) || isTutor(d.member_ids[1]))
          && d.members is map && d.members.keys().hasOnly(d.member_ids) && d.members.size() == 2
          && validMember(d.members[d.member_ids[0]]) && validMember(d.members[d.member_ids[1]])
          && d.last_message == '' && d.last_sender_id == '' && d.get('last_message_at', null) == null
          && d.unread_count is map && d.unread_count.keys().hasOnly(d.member_ids) && d.unread_count.values().hasOnly([0])
          && d.read_at is map && d.read_at.size() == 0
          && (!('lesson' in d) || validLesson(d.lesson))
          && d.created_by == request.auth.uid
          && d.created_at == request.time && d.updated_at == request.time;
      }
      function validUnread(before, after, data) {
        let changed = after.unread_count.diff(before.unread_count).affectedKeys();
        let me = request.auth.uid;
        let peer = peerOf(data);
        return changed.hasOnly([me, peer])
          && (!(me in changed) || after.unread_count[me] == 0)
          && (!(peer in changed) || (after.unread_count[peer] == before.unread_count.get(peer, 0) + 1
                                      && after.last_message_at == request.time));
      }
      function validUpdate(before, after) {
        let changed = after.diff(before).affectedKeys();
        let me = request.auth.uid;
        return changed.hasOnly(['members','last_message','last_sender_id','last_message_at','unread_count','read_at','lesson','updated_at'])
          && after.member_ids == before.member_ids
          && (!('updated_at' in changed) || after.updated_at == request.time)
          && (!('members' in changed) || (after.members.diff(before.members).affectedKeys().hasOnly([me]) && validMember(after.members[me])))
          && (!(('last_message' in changed) || ('last_sender_id' in changed) || ('last_message_at' in changed))
              || (after.last_sender_id == me && after.last_message is string
                  && after.last_message.size() > 0 && after.last_message.size() <= 1000
                  && after.last_message_at == request.time))
          && (!('unread_count' in changed) || validUnread(before, after, before))
          && (!('read_at' in changed) || (after.read_at.diff(before.read_at).affectedKeys().hasOnly([me]) && after.read_at[me] == request.time))
          && (!('lesson' in changed) || validLesson(after.lesson));
      }

      allow get: if request.auth != null && (resource == null || isMember(resource.data));
      allow list: if isMember(resource.data);
      allow list: if request.auth != null && request.auth.uid in resource.data.member_ids;
      allow create: if notBanned() && validNew(request.resource.data);
      allow update: if isMember(resource.data) && validUpdate(resource.data, request.resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        function conversationBefore() { return get(/databases/$(database)/documents/conversations/$(conversationId)).data; }
        function conversationAfter() { return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data; }
        allow read: if request.auth != null && request.auth.uid in conversationBefore().member_ids;
        // Tin phải được ghi cùng batch với phần tóm tắt hội thoại (last_message_at = request.time).
        allow create: if notBanned()
          && request.auth.uid in conversationAfter().member_ids
          && conversationAfter().last_message_at == request.time
          && request.resource.data.keys().hasAll(['sender_id','client_message_id','content','sent_at'])
          && request.resource.data.keys().hasOnly(['sender_id','client_message_id','content','sent_at'])
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.client_message_id == messageId
          && request.resource.data.content is string
          && request.resource.data.content.trim().size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.sent_at == request.time;
        allow update, delete: if false;
      }
    }
    // Trạng thái "Đang hoạt động" ở màn 06: ai đăng nhập cũng xem được, chỉ chủ tài khoản ghi.
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['online','last_seen'])
        && request.resource.data.online is bool
        && request.resource.data.last_seen == request.time;
      allow delete: if false;
    }
    // ---------------------------------------------------------------------------------------------
    // UC23 – Chốt hợp đồng dạy (màn 40, Hợp đồng của tôi). contracts/{id}: chỉ 2 bên (và quản trị viên) đọc.
    // Bên đề nghị tạo ở trạng thái CHO_XAC_NHAN và tự xác nhận phần của mình; bên còn lại xác nhận (→ CHO_KY_QUY)
    // hoặc từ chối (→ TU_CHOI); bên đề nghị được hủy (→ DA_HUY). Nội dung không sửa được sau khi gửi.
    // ---------------------------------------------------------------------------------------------
    match /contracts/{contractId} {
      function isParty(data) { return request.auth != null && request.auth.uid in [data.student_id, data.tutor_id]; }
      function validContract(d) {
        let conversation = get(/databases/$(database)/documents/conversations/$(d.conversation_id)).data;
        let me = request.auth.uid;
        return d.keys().hasOnly(['code','conversation_id','student_id','tutor_id','member_ids','student_name','tutor_name',
                                 'subject','sessions','minutes','schedule','start_date','start_at','mode','fee','total','terms',
                                 'proposed_by','student_confirmed','tutor_confirmed','status','reject_reason','confirmed_at',
                                 'created_at','updated_at'])
          && d.student_id is string && d.tutor_id is string && d.student_id != d.tutor_id
          && d.member_ids == [d.student_id, d.tutor_id]
          && me in d.member_ids && d.proposed_by == me
          && d.conversation_id is string && conversation.member_ids.hasAll([d.student_id, d.tutor_id])
          && verifiedTutor(d.tutor_id)
          && d.code is string && d.code.size() <= 12
          && d.student_name is string && d.student_name.size() <= 100
          && d.tutor_name is string && d.tutor_name.size() <= 100
          && d.subject is string && d.subject.size() >= 2 && d.subject.size() <= 120
          && d.sessions is int && d.sessions >= 1 && d.sessions <= 60
          && d.minutes in [60, 90, 120]
          && d.fee is int && d.fee >= 50000 && d.fee <= 2000000
          && d.total == d.fee * d.sessions
          && d.schedule is string && d.schedule.size() <= 80
          && d.start_date is string && d.start_date.size() <= 20
          && d.start_at is timestamp && d.start_at > request.time
          && d.mode in ['Trực tuyến', 'Tại nhà']
          && d.terms is string && d.terms.size() <= 1000
          && d.student_confirmed == (me == d.student_id) && d.tutor_confirmed == (me == d.tutor_id)
          && d.status == 'CHO_XAC_NHAN' && d.reject_reason == '' && d.confirmed_at == null
          && d.created_at == request.time && d.updated_at == request.time;
      }
      function contractChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function confirming() {
        let flag = request.auth.uid == resource.data.student_id ? 'student_confirmed' : 'tutor_confirmed';
        return contractChanged().hasOnly([flag, 'status', 'confirmed_at', 'updated_at'])
          && request.resource.data[flag] == true
          && request.resource.data.status == 'CHO_KY_QUY'
          && request.resource.data.confirmed_at == request.time;
      }
      function rejecting() {
        return contractChanged().hasOnly(['status', 'reject_reason', 'updated_at'])
          && request.resource.data.status == 'TU_CHOI'
          && request.resource.data.reject_reason is string && request.resource.data.reject_reason.size() <= 300;
      }
      function cancelling() {
        return contractChanged().hasOnly(['status', 'updated_at']) && request.resource.data.status == 'DA_HUY';
      }

      allow get: if isParty(resource.data) || admin();
      // Truy vấn whereArrayContains("member_ids", uid): điều kiện phải chứng minh được từ chính truy vấn.
      allow list: if request.auth != null && request.auth.uid in resource.data.member_ids;
      allow create: if notBanned() && validContract(request.resource.data);
      allow update: if isParty(resource.data) && notBanned()
        && resource.data.status == 'CHO_XAC_NHAN'
        && request.resource.data.updated_at == request.time
        && ((request.auth.uid != resource.data.proposed_by && (confirming() || rejecting()))
            || (request.auth.uid == resource.data.proposed_by && cancelling()));
      allow delete: if false;
    }
    // All other collections, including the removed flows, are denied by default.
  }
}
