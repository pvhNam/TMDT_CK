<resources>
    <style name="ThemeOverlay.TMDT.Classroom.DatePicker" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_classroom_dialog</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/app_ink</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="android:datePickerStyle">@style/Widget.TMDT.Classroom.DatePicker</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.TMDT.Classroom.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.TMDT.Classroom.DialogButton.Muted</item>
    </style>
    <style name="Widget.TMDT.Classroom.DatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@drawable/bg_classroom_date_header</item>
        <item name="android:calendarTextColor">@color/app_ink</item>
    </style>
</resources>
