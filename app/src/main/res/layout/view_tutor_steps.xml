<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">
        <TextView
            android:id="@+id/step_info"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_tutor_step"
            android:gravity="center"
            android:fontFamily="sans-serif-condensed"
            android:textSize="18sp"
            android:text="1" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/tutor_border" />
        <TextView
            android:id="@+id/step_review"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_tutor_step"
            android:gravity="center"
            android:fontFamily="sans-serif-condensed"
            android:textSize="18sp"
            android:text="2" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/label_info"
            style="@style/TutorText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="15sp"
            android:gravity="start"
            android:paddingStart="20dp"
            android:text="@string/tutor_step_info" />
        <TextView
            android:id="@+id/label_review"
            style="@style/TutorText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textSize="15sp"
            android:gravity="end"
            android:paddingEnd="20dp"
            android:text="@string/tutor_step_review" />
    </LinearLayout>
</LinearLayout>