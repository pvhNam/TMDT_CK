<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@android:color/white">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" style="@style/ReferenceToolbar" app:title="@string/request_heading" />
    <ScrollView android:id="@+id/request_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/request_error" style="@style/BodyText"
                android:textColor="#B3261E" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <ProgressBar android:id="@+id/request_progress" android:layout_width="32dp"
                android:layout_height="32dp" android:layout_gravity="center_horizontal"
                android:contentDescription="@string/request_publishing" android:visibility="gone" />
            <LinearLayout android:id="@+id/request_form" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/BodyText" android:text="@string/request_intro" />
                <TextView style="@style/FieldLabel" android:text="@string/request_title" android:labelFor="@id/request_title" />
                <EditText android:id="@+id/request_title" style="@style/FormInput"
                    android:hint="@string/request_title_hint" android:inputType="textCapSentences"
                    android:maxLength="120" android:importantForAutofill="no" />
                <TextView style="@style/FieldLabel" android:text="@string/request_subject" android:labelFor="@id/request_subject" />
                <EditText android:id="@+id/request_subject" style="@style/FormInput"
                    android:hint="@string/request_subject_hint" android:inputType="none"
                    android:focusable="false" android:clickable="true" android:importantForAutofill="no"
                    android:drawableEnd="@drawable/ic_right" />
                <TextView style="@style/FieldLabel" android:text="@string/request_level" android:labelFor="@id/request_level" />
                <EditText android:id="@+id/request_level" style="@style/FormInput"
                    android:hint="@string/request_level_hint" android:inputType="none"
                    android:focusable="false" android:clickable="true" android:importantForAutofill="no"
                    android:drawableEnd="@drawable/ic_right" />
                <TextView style="@style/FieldLabel" android:text="@string/request_budget" android:labelFor="@id/request_budget" />
                <EditText android:id="@+id/request_budget" style="@style/FormInput"
                    android:hint="@string/request_budget_hint" android:inputType="number"
                    android:maxLength="8" android:importantForAutofill="no" />
                <TextView style="@style/FieldLabel" android:text="@string/request_schedule" android:labelFor="@id/request_schedule" />
                <EditText android:id="@+id/request_schedule" style="@style/FormInput"
                    android:hint="@string/request_schedule_hint" android:inputType="textCapSentences|textMultiLine"
                    android:singleLine="false" android:minLines="2" android:gravity="top|start"
                    android:maxLength="300" android:importantForAutofill="no" />
                <TextView style="@style/FieldLabel" android:text="@string/request_description" android:labelFor="@id/request_description" />
                <EditText android:id="@+id/request_description" style="@style/FormInput"
                    android:hint="@string/request_description_hint" android:inputType="textCapSentences|textMultiLine"
                    android:singleLine="false" android:minLines="4" android:gravity="top|start"
                    android:maxLength="2000" android:importantForAutofill="no" />
                <com.google.android.material.button.MaterialButton android:id="@+id/publish_request"
                    style="@style/PrimaryButton" android:text="@string/request_publish" />
            </LinearLayout>
            <LinearLayout android:id="@+id/request_success" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/ScreenTitle" android:text="@string/request_success" android:accessibilityLiveRegion="polite" />
                <TextView style="@style/BodyText" android:text="@string/request_success_caption" />
                <TextView android:id="@+id/request_summary" style="@style/BodyText"
                    android:background="@drawable/bg_pale" android:padding="20dp" android:textIsSelectable="true" />
                <com.google.android.material.button.MaterialButton android:id="@+id/request_home"
                    style="@style/PrimaryButton" android:text="@string/request_home" />
                <com.google.android.material.button.MaterialButton android:id="@+id/new_request"
                    style="@style/SecondaryButton" android:text="@string/request_new" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
