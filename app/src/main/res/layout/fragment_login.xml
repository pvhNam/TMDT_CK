<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.tmdt.ui.auth.LoginFragment">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/page_login"
        app:titleTextColor="#081F50"
        app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="@string/back" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <include
                layout="@layout/view_account_feedback" />
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:background="@drawable/bg_pale"
                    android:padding="22dp"
                    android:src="@drawable/ic_cap"
                    android:importantForAccessibility="no"
                    android:layout_marginBottom="20dp" />
                <TextView
                    style="@style/ScreenTitle"
                    android:text="@string/welcome"
                    android:gravity="center" />
                <TextView
                    style="@style/BodyText"
                    android:text="@string/login_caption"
                    android:gravity="center"
                    android:paddingBottom="12dp" />
                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/email"
                    android:labelFor="@id/email" />
                <EditText
                    android:id="@+id/email"
                    style="@style/FormInput"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    android:maxLength="254"
                    android:autofillHints="emailAddress" />
                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/password"
                    android:labelFor="@id/password" />
                <EditText
                    android:id="@+id/password"
                    style="@style/FormInput"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:autofillHints="password" />
                <CheckBox
                    android:id="@+id/show_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/show_password" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgot"
                    style="@style/TextButton"
                    android:text="@string/forgot_link"
                    android:contentDescription="@string/forgot_link" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_in"
                    style="@style/PrimaryButton"
                    android:text="@string/page_login"
                    android:contentDescription="@string/page_login" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register"
                    style="@style/SecondaryButton"
                    android:text="@string/register_link"
                    android:contentDescription="@string/register_link" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>