<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context="com.example.tmdt.ui.auth.LoginFragment">
    <com.example.tmdt.ui.common.SoftBlurBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ReferenceToolbar"
        app:title="@string/page_login"
        android:visibility="gone" />
    <ScrollView
        android:id="@+id/account_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">
            <include
                layout="@layout/view_account_feedback" />
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"
                    android:src="@drawable/illustration_learning"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    style="@style/ReferenceTitle"
                    android:textSize="26sp"
                    android:letterSpacing="-0.02"
                    android:text="@string/welcome"
                    android:gravity="center" />
                <TextView
                    style="@style/ReferenceBody"
                    android:textSize="14sp"
                    android:text="@string/login_caption"
                    android:gravity="center"
                    android:layout_marginBottom="30dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_layout"
                    style="@style/LoginGlassField"
                    app:startIconDrawable="@drawable/ic_field_email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        style="@style/LoginInput"
                        android:hint="@string/ref_email_hint"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress"
                        android:maxLength="254" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout"
                    style="@style/LoginGlassField"
                    app:startIconDrawable="@drawable/ic_field_lock"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        style="@style/LoginInput"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:maxLength="128" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgot"
                    style="@style/ReferenceLink"
                    android:text="@string/forgot_link"
                    android:contentDescription="@string/forgot_link"
                    android:layout_gravity="end"
                    android:layout_marginTop="-8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_in"
                    style="@style/LoginPrimary"
                    android:text="@string/page_login"
                    android:contentDescription="@string/page_login" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View android:layout_width="0dp" android:layout_height="1dp"
                        android:layout_weight="1" android:background="#DCE8FA" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp" android:text="@string/sign_in_or"
                        android:textColor="#7083AC" android:textSize="13sp" />
                    <View android:layout_width="0dp" android:layout_height="1dp"
                        android:layout_weight="1" android:background="#DCE8FA" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/google_sign_in"
                        style="@style/LoginGlassSocialButton"
                        android:contentDescription="@string/sign_in_google"
                        android:tooltipText="@string/sign_in_google"
                        app:icon="@drawable/ic_google" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/facebook_sign_in"
                        style="@style/LoginGlassSocialButton"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/sign_in_facebook"
                        android:tooltipText="@string/sign_in_facebook"
                        app:icon="@drawable/ic_facebook" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/apple_sign_in"
                        style="@style/LoginGlassSocialButton"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/sign_in_apple"
                        android:tooltipText="@string/sign_in_apple"
                        app:icon="@drawable/ic_apple" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register"
                    style="@style/LoginGlassFooter"
                    android:text="@string/ref_register_footer"
                    android:contentDescription="@string/register_link" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </LinearLayout>
</FrameLayout>
