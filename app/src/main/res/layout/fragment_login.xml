<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context="com.example.tmdt.ui.auth.LoginFragment">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ReferenceToolbar"
        app:title="@string/page_login"
        android:visibility="gone" />
    <ScrollView
        android:id="@+id/account_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">
            <include
                layout="@layout/view_account_feedback" />
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="182dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/illustration_learning"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    style="@style/ReferenceTitle"
                    android:text="@string/welcome"
                    android:gravity="center" />
                <TextView
                    style="@style/ReferenceBody"
                    android:text="@string/login_caption"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_layout"
                    style="@style/ReferenceFilledField"
                    app:startIconDrawable="@drawable/ic_field_email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        style="@style/ReferenceInput"
                        android:hint="@string/ref_email_hint"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress"
                        android:maxLength="254" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout"
                    style="@style/ReferenceFilledField"
                    app:startIconDrawable="@drawable/ic_field_lock"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        style="@style/ReferenceInput"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:maxLength="128" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgot"
                    style="@style/ReferenceLink"
                    android:text="@string/forgot_link"
                    android:contentDescription="@string/forgot_link"
                    android:layout_gravity="end"
                    android:layout_marginTop="-8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_in"
                    style="@style/ReferencePrimary"
                    android:text="@string/page_login"
                    android:contentDescription="@string/page_login" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register"
                    style="@style/ReferenceFooter"
                    android:text="@string/ref_register_footer"
                    android:contentDescription="@string/register_link" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>