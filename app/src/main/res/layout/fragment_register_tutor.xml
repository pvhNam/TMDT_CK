<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context="com.example.tmdt.ui.profile.RegisterTutorFragment">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ReferenceToolbar"
        app:titleTextAppearance="@style/TutorToolbarTitle"
        app:title="@string/tutor_register" />
    <ScrollView
        android:id="@+id/account_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">
            <include
                layout="@layout/view_account_feedback" />
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include
                    android:id="@+id/steps"
                    layout="@layout/view_tutor_steps" />
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/name"
                    android:labelFor="@id/name" />
                <EditText
                    android:id="@+id/name"
                    style="@style/TutorInput"
                    android:hint="@string/name"
                    android:inputType="textCapWords"
                    android:importantForAutofill="no"
                    android:maxLength="100" />
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/phone"
                    android:labelFor="@id/phone" />
                <EditText
                    android:id="@+id/phone"
                    style="@style/TutorInput"
                    android:hint="@string/ref_phone_hint"
                    android:inputType="phone"
                    android:importantForAutofill="no"
                    android:maxLength="20" />
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/tutor_subject"
                    android:labelFor="@id/subject" />
                <EditText
                    android:id="@+id/subject"
                    style="@style/TutorInput"
                    android:hint="@string/tutor_select_subject"
                    android:inputType="none"
                    android:importantForAutofill="no"
                    android:focusable="false"
                    android:clickable="true" />
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/level"
                    android:labelFor="@id/levels" />
                <EditText
                    android:id="@+id/levels"
                    style="@style/TutorInput"
                    android:hint="@string/tutor_select_levels"
                    android:inputType="none"
                    android:importantForAutofill="no"
                    android:focusable="false"
                    android:clickable="true"
                    android:singleLine="false" />
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/tutor_experience"
                    android:labelFor="@id/experience" />
                <EditText
                    android:id="@+id/experience"
                    style="@style/TutorInput"
                    android:hint="@string/tutor_experience_hint"
                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:maxLength="2"
                    android:minHeight="55dp" />
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/tutor_mode" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/online"
                        style="@style/TutorMode"
                        android:text="@string/tutor_online"
                        android:layout_marginEnd="10dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/in_person"
                        style="@style/TutorMode"
                        android:text="@string/tutor_in_person" />
                </LinearLayout>
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/tutor_price"
                    android:labelFor="@id/price" />
                <EditText
                    android:id="@+id/price"
                    style="@style/TutorInput"
                    android:hint="@string/tutor_price_hint"
                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:maxLength="7" />
                <TextView
                    android:id="@+id/next_note"
                    style="@style/TutorText"
                    android:text="@string/tutor_next_note"
                    android:textSize="13sp"
                    android:textColor="@color/tutor_muted"
                    android:drawablePadding="9dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continue_button"
                    style="@style/TutorPrimary"
                    android:text="@string/tutor_continue" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>