<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context="com.example.tmdt.ui.profile.EditAccountFragment">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ReferenceToolbar"
        app:title="@string/page_edit" />
    <ScrollView
        android:id="@+id/account_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">
            <include
                layout="@layout/view_account_feedback" />
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp">
                    <include
                        android:id="@+id/avatar"
                        layout="@layout/view_avatar"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/camera"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_gravity="bottom|end"
                        android:insetTop="6dp"
                        android:insetBottom="6dp"
                        android:insetLeft="6dp"
                        android:insetRight="6dp"
                        android:padding="0dp"
                        app:cornerRadius="24dp"
                        app:backgroundTint="@color/account_blue"
                        app:icon="@drawable/ic_field_camera"
                        app:iconTint="@android:color/white"
                        app:iconSize="18dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        android:contentDescription="@string/change_avatar" />
                </FrameLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/change_avatar"
                    style="@style/ReferenceFooter"
                    android:text="@string/ref_change_avatar"
                    android:contentDescription="@string/ref_change_avatar"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp"
                    android:textSize="12sp"
                    app:cornerRadius="24dp" />
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/name"
                    android:labelFor="@id/name" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/name_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_user">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name"
                        style="@style/ReferenceInput"
                        android:hint="@string/name"
                        android:inputType="textCapWords"
                        android:autofillHints="personName"
                        android:maxLength="100" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/email"
                    android:labelFor="@id/email" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_layout"
                    style="@style/ReferenceFilledField"
                    app:startIconDrawable="@drawable/ic_field_email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        style="@style/ReferenceInput"
                        android:hint="@string/email"
                        android:inputType="textEmailAddress"
                        android:importantForAutofill="no"
                        android:focusable="false"
                        android:clickable="false"
                        android:longClickable="false" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/phone"
                    android:labelFor="@id/phone" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phone_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_phone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone"
                        style="@style/ReferenceInput"
                        android:hint="@string/ref_phone_hint"
                        android:inputType="phone"
                        android:autofillHints="phoneNumber"
                        android:maxLength="20" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/level"
                    android:labelFor="@id/level" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/level_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_level"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_field_chevron"
                    app:endIconContentDescription="@string/ref_select_level">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/level"
                        style="@style/ReferenceInput"
                        android:hint="@string/level"
                        android:inputType="text"
                        android:importantForAutofill="no"
                        android:focusable="false"
                        android:clickable="true"
                        android:maxLength="80" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/region"
                    android:labelFor="@id/region" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/region_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_location"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_field_chevron"
                    app:endIconContentDescription="@string/ref_select_region">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/region"
                        style="@style/ReferenceInput"
                        android:hint="@string/region"
                        android:inputType="textCapWords"
                        android:importantForAutofill="no"
                        android:maxLength="120" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/goal"
                    android:labelFor="@id/goal" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/goal_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_note">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/goal"
                        style="@style/ReferenceInput"
                        android:hint="@string/goal"
                        android:inputType="textMultiLine|textCapSentences"
                        android:importantForAutofill="no"
                        android:singleLine="false"
                        android:minLines="2"
                        android:maxLength="500"
                        android:gravity="top|start" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/address"
                    android:labelFor="@id/address" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/address_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_address">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/address"
                        style="@style/ReferenceInput"
                        android:hint="@string/address"
                        android:inputType="textCapSentences"
                        android:autofillHints="postalAddress"
                        android:maxLength="255" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save"
                    style="@style/ReferencePrimary"
                    android:text="@string/save_profile"
                    android:contentDescription="@string/save_profile" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
