<?xml version="1.0" encoding="utf-8"?>
<!-- Màn 40 – Chốt hợp đồng dạy (UC23): kiểm tra các bên, lịch, số buổi, học phí, thỏa thuận; xác nhận và chuyển sang ký quỹ. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context="com.example.tmdt.ui.exchange.ContractFragment">

    <include
        android:id="@+id/header"
        layout="@layout/view_ex_header" />

    <TextView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@color/chat_muted"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Số hợp đồng và trạng thái -->
            <LinearLayout
                style="@style/ExCard"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ex_doc" />

                <TextView
                    android:id="@+id/code"
                    style="@style/ExValue"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    style="@style/ExPill" />
            </LinearLayout>

            <TextView
                android:id="@+id/closed_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ex_pale"
                android:padding="12dp"
                android:textColor="@color/chat_red"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Các bên -->
            <TextView
                style="@style/ExSection"
                android:text="@string/ex_parties" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/student_card"
                    style="@style/ExCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <include
                        android:id="@+id/student_avatar"
                        layout="@layout/view_ex_avatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ExLabel"
                            android:text="@string/ex_student" />

                        <TextView
                            android:id="@+id/student_name"
                            style="@style/ExName"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/tutor_card"
                    style="@style/ExCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <include
                        android:id="@+id/tutor_avatar"
                        layout="@layout/view_ex_avatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ExLabel"
                            android:text="@string/ex_tutor" />

                        <TextView
                            android:id="@+id/tutor_name"
                            style="@style/ExName"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Thông tin lớp học: chế độ xem -->
            <TextView
                style="@style/ExSection"
                android:text="@string/ex_class_info" />

            <LinearLayout
                android:id="@+id/info_view"
                style="@style/ExCard"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/subject_view"
                    style="@style/ExInfoRow"
                    android:drawableStart="@drawable/ic_ex_book" />

                <TextView
                    android:id="@+id/sessions_view"
                    style="@style/ExInfoRow"
                    android:drawableStart="@drawable/ic_ex_list" />

                <TextView
                    android:id="@+id/schedule_view"
                    style="@style/ExInfoRow"
                    android:drawableStart="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/start_view"
                    style="@style/ExInfoRow"
                    android:drawableStart="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/mode_view"
                    style="@style/ExInfoRow"
                    android:drawableStart="@drawable/ic_laptop" />
            </LinearLayout>

            <!-- Gia sư soạn hợp đồng: chỉ sửa môn, số buổi, học phí; lịch, thời lượng, hình thức theo buổi học đã đặt -->
            <LinearLayout
                android:id="@+id/info_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/ExLabel"
                    android:text="@string/ex_subject" />

                <EditText
                    android:id="@+id/subject_input"
                    style="@style/ExTextInput"
                    android:layout_marginTop="6dp"
                    android:inputType="textCapSentences"
                    android:maxLength="120"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ExLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/ex_sessions" />

                    <ImageButton
                        android:id="@+id/minus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ex_field"
                        android:contentDescription="@string/ex_decrease"
                        android:src="@drawable/ic_ex_minus" />

                    <TextView
                        android:id="@+id/sessions_value"
                        style="@style/ExValue"
                        android:layout_width="56dp"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/plus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ex_field"
                        android:contentDescription="@string/ex_increase"
                        android:src="@drawable/ic_ex_plus" />
                </LinearLayout>

                <TextView
                    style="@style/ExLabel"
                    android:layout_marginTop="10dp"
                    android:text="@string/ex_fee" />

                <EditText
                    android:id="@+id/fee_input"
                    style="@style/ExTextInput"
                    android:layout_marginTop="6dp"
                    android:inputType="number"
                    android:maxLength="8"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Chi phí -->
            <TextView
                style="@style/ExSection"
                android:text="@string/ex_cost" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ex_pale"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/fee_value"
                    style="@style/ExValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ExLabel"
                        android:text="@string/ex_total" />

                    <TextView
                        android:id="@+id/total_value"
                        style="@style/ExValue"
                        android:textColor="@color/chat_blue"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/terms_row"
                style="@style/ExCard"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_ex_doc"
                android:drawableEnd="@drawable/ic_right"
                android:drawablePadding="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:text="@string/ex_terms"
                android:textColor="@color/chat_ink"
                android:textSize="14sp" />

            <TextView
                style="@style/ExNote"
                android:background="@drawable/bg_ex_pale"
                android:padding="10dp"
                android:text="@string/ex_terms_note" />

            <CheckBox
                android:id="@+id/agree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="@color/chat_blue"
                android:text="@string/ex_agree"
                android:textColor="@color/chat_ink"
                android:textSize="13.5sp" />

            <TextView
                style="@style/ExNote"
                android:layout_marginTop="2dp"
                android:text="@string/ex_effective_note" />
        </LinearLayout>
    </ScrollView>

    <!-- Thao tác -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primary"
            style="@style/ExPrimary"
            app:icon="@drawable/ic_ex_shield" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondary"
                style="@style/ExOutline"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tertiary"
                style="@style/ExDanger"
                android:layout_width="0dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
