<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@android:color/white" android:padding="16dp">
    <TextView android:id="@+id/class_questions_title" style="@style/ScreenTitle"
        android:text="@string/class_questions_title" android:textSize="22sp" android:layout_marginBottom="4dp" />
    <TextView android:id="@+id/class_questions_class_title" style="@style/FieldLabel" android:maxLines="2" android:ellipsize="end" />
    <TextView style="@style/BodyText" android:text="@string/class_questions_caption" android:layout_marginBottom="10dp" />
    <ScrollView android:id="@+id/class_questions_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ProgressBar android:id="@+id/class_questions_progress" android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center_horizontal" android:contentDescription="@string/class_questions_loading" android:visibility="gone" />
            <TextView android:id="@+id/class_questions_offline" style="@style/BodyText" android:text="@string/class_questions_offline"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView android:id="@+id/class_questions_error" style="@style/BodyText" android:textColor="#B3261E"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView android:id="@+id/class_questions_notice" style="@style/BodyText" android:textColor="#236B42"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/class_questions_retry"
                style="@style/SecondaryButton" android:text="@string/class_questions_retry" android:visibility="gone" />
            <TextView android:id="@+id/class_questions_empty" style="@style/BodyText" android:text="@string/class_questions_empty"
                android:background="@drawable/bg_pale" android:padding="16dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/class_questions_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/class_questions_load_more"
                style="@style/SecondaryButton" android:text="@string/class_questions_load_more" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/class_questions_read_only" style="@style/BodyText" android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <LinearLayout android:id="@+id/class_questions_composer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/class_question_reply_target" style="@style/FieldLabel" android:layout_width="0dp"
                android:layout_weight="1" android:layout_marginBottom="0dp" android:maxLines="1" android:ellipsize="end" android:text="@string/class_questions_question_label" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cancel_class_question_reply"
                style="@style/TextButton" android:layout_width="wrap_content" android:minHeight="40dp"
                android:text="@string/class_questions_new_question" android:visibility="gone" />
        </LinearLayout>
        <EditText android:id="@+id/class_question_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine" android:gravity="top|start" android:minLines="2" android:maxLines="4"
            android:maxLength="1000" android:padding="10dp" android:background="@drawable/bg_input"
            android:textSize="14sp" android:textColor="#081F50" android:hint="@string/class_questions_input_hint"
            android:saveEnabled="false" android:importantForAutofill="no" />
        <TextView android:id="@+id/class_question_character_count" style="@style/BodyText" android:textSize="12sp"
            android:gravity="end" android:layout_marginBottom="2dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/send_class_question"
            style="@style/PrimaryButton" android:text="@string/class_questions_send" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/class_questions_sign_in"
        style="@style/PrimaryButton" android:text="@string/class_questions_sign_in" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/close_class_questions"
        style="@style/SecondaryButton" android:text="@string/class_questions_close" />
</LinearLayout>
