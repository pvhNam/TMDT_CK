<?xml version="1.0" encoding="utf-8"?>
<!-- Màn 50 – Xử lý báo cáo (UC29): xem phản ánh và minh chứng, chọn hướng xử lý, ghi kết luận, xác nhận; có hoàn tiền. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context="com.example.tmdt.ui.admin.HandleReportFragment">

    <include
        android:id="@+id/header"
        layout="@layout/view_ex_header" />

    <TextView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@color/chat_muted"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                style="@style/ExCard"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:background="@drawable/bg_ex_alert_circle"
        android:src="@drawable/ic_ex_alert" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/code"
                        style="@style/ExName" />

                    <TextView
                        android:id="@+id/reason"
                        style="@style/ExValue"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/date"
                        style="@style/ExLabel"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    style="@style/ExPill" />
            </LinearLayout>

            <TextView
                style="@style/ExSection"
                android:text="@string/ex_reporter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/reporter_avatar"
                    layout="@layout/view_ex_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/reporter_name"
                        style="@style/ExName" />

                    <TextView
                        android:id="@+id/reporter_role"
                        style="@style/ExLabel" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ExSection"
                android:text="@string/ex_reported" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/target_avatar"
                    layout="@layout/view_ex_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/target_name"
                        style="@style/ExName" />

                    <TextView
                        android:id="@+id/target_role"
                        style="@style/ExLabel" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ExSection"
                android:text="@string/ex_report_body" />

            <TextView
                android:id="@+id/description"
                style="@style/ExValue"
                android:layout_width="match_parent"
                android:background="@drawable/bg_ex_pale"
                android:lineSpacingExtra="2dp"
                android:padding="12dp" />

            <TextView
                style="@style/ExSection"
                android:text="@string/ex_attached" />

            <TextView
                android:id="@+id/evidence_empty"
                style="@style/ExLabel" />

            <LinearLayout
                android:id="@+id/evidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Kết quả đã xử lý -->
            <LinearLayout
                android:id="@+id/decision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/ExSection"
                    android:text="@string/ex_decision" />

                <TextView
                    android:id="@+id/decision_text"
                    style="@style/ExValue"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_ex_pale"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Biểu mẫu xử lý -->
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/ExSection"
                    android:text="@string/ex_outcome" />

                <TextView
                    android:id="@+id/outcome"
                    style="@style/ExField"
                    android:hint="@string/ex_outcome_hint" />

                <LinearLayout
                    android:id="@+id/refund_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        style="@style/ExValue"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/ex_refund_amount"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/refund"
                        style="@style/ExTextInput"
                        android:layout_width="0dp"
                        android:layout_weight="1.2"
                        android:inputType="number"
                        android:maxLength="9"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/refund_hint"
                    style="@style/ExLabel"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/conclusion_title"
                    style="@style/ExSection"
                    android:text="@string/ex_conclusion" />

                <EditText
                    android:id="@+id/conclusion"
                    style="@style/ExMultiInput"
                    android:hint="@string/ex_conclusion_hint"
                    android:minHeight="90dp" />

                <TextView
                    android:id="@+id/counter"
                    style="@style/ExCounter" />

                <TextView
                    style="@style/ExNote"
                    android:text="@string/ex_handle_note" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/submit"
        style="@style/ExPrimary"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:text="@string/ex_confirm_handle"
        app:icon="@drawable/ic_chat_check" />
</LinearLayout>
