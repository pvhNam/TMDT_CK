<?xml version="1.0" encoding="utf-8"?>
<!-- Tin nhắn nhận được: ảnh người gửi, bong bóng nền nhạt, giờ gửi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingEnd="48dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <TextView
            android:id="@+id/avatar_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_chat_avatar_circle"
            android:gravity="center"
            android:textColor="@color/chat_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/chat_avatar"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ChatAvatarCircle" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_in"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/chat_ink"
            android:textIsSelectable="true"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/chat_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
