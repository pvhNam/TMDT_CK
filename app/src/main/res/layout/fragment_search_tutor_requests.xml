<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@android:color/white">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        style="@style/ReferenceToolbar" app:title="@string/request_search_title" />
    <ScrollView android:id="@+id/search_requests_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/BodyText" android:text="@string/request_search_intro" />
            <LinearLayout android:id="@+id/search_filters" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/FieldLabel" android:text="@string/request_search_subject"
                    android:labelFor="@id/request_search_subject" />
                <EditText android:id="@+id/request_search_subject" style="@style/FormInput"
                    android:hint="@string/request_search_choose_subject" android:inputType="none"
                    android:focusable="false" android:clickable="true" android:importantForAutofill="no"
                    android:drawableEnd="@drawable/ic_right" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reset_search_filter"
                    style="@style/TextButton" android:text="@string/request_search_reset"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>
            <ProgressBar android:id="@+id/search_requests_progress" android:layout_width="32dp"
                android:layout_height="32dp" android:layout_gravity="center_horizontal"
                android:contentDescription="@string/request_search_loading" android:visibility="gone" />
            <LinearLayout android:id="@+id/search_permission_panel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_pale" android:padding="20dp" android:visibility="gone">
                <TextView style="@style/SectionTitle" android:text="@string/request_search_permission_title"
                    android:layout_marginTop="0dp" />
                <TextView style="@style/BodyText" android:text="@string/request_search_permission_caption"
                    android:layout_marginBottom="0dp" />
            </LinearLayout>
            <TextView android:id="@+id/search_requests_offline" style="@style/BodyText"
                android:text="@string/request_search_offline" android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <TextView android:id="@+id/search_requests_error" style="@style/BodyText"
                android:textColor="#B3261E" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/retry_search"
                style="@style/SecondaryButton" android:text="@string/request_search_retry"
                android:layout_marginBottom="12dp" android:visibility="gone" />
            <TextView android:id="@+id/search_requests_count" style="@style/SectionTitle"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView android:id="@+id/search_requests_empty" style="@style/BodyText"
                android:text="@string/request_search_empty" android:padding="20dp"
                android:background="@drawable/bg_pale" android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/search_requests_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
