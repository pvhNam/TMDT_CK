<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/app_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/app_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/submission_row_name" style="@style/FieldLabel" android:textColor="@color/app_ink" android:textSize="17sp" />
        <TextView android:id="@+id/submission_row_status" style="@style/AssignmentBody" android:textColor="@color/app_accent" android:textSize="12sp" />
        <TextView android:id="@+id/submission_row_time" style="@style/AssignmentBody" android:textSize="12sp" />
        <TextView android:id="@+id/submission_row_content" style="@style/AssignmentBody" android:textColor="@color/app_ink" android:textIsSelectable="true" />
        <com.google.android.material.button.MaterialButton android:id="@+id/submission_open_link" style="@style/AssignmentSecondary" android:text="@string/assignments_open_link" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/submission_open_attachment" style="@style/AssignmentSecondary" android:visibility="gone" />
        <TextView android:id="@+id/submission_row_score" style="@style/AssignmentLabel" android:visibility="gone" />
        <TextView android:id="@+id/submission_row_feedback" style="@style/AssignmentBody" android:visibility="gone" android:textIsSelectable="true" />
        <com.google.android.material.button.MaterialButton android:id="@+id/submission_review" style="@style/AssignmentSecondary" android:text="@string/assignments_review" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
