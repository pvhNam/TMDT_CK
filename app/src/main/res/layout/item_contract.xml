<?xml version="1.0" encoding="utf-8"?>
<!-- Một hợp đồng trong danh sách "Hợp đồng của tôi". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ExCard"
    android:background="@drawable/bg_section_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_ex_icon_circle"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ic_ex_doc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/subject"
                style="@style/ExName"
                android:textSize="16sp"
                android:maxLines="2"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/code"
                style="@style/ExLabel"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginStart="8dp" android:importantForAccessibility="no"
            android:src="@drawable/ic_right" app:tint="@color/app_muted" />
    </LinearLayout>

    <TextView android:id="@+id/status" style="@style/ExPill"
        android:layout_marginTop="12dp" android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/party"
        style="@style/ExInfoRow"
        android:layout_marginTop="6dp"
        android:drawableStart="@drawable/ic_user"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/schedule"
        style="@style/ExInfoRow"
        android:drawableStart="@drawable/ic_calendar"
        android:textSize="13sp" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="10dp" android:layout_marginBottom="12dp"
        android:background="@color/app_border" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView style="@style/ExLabel" android:text="@string/hub_contract_total"
            android:layout_marginEnd="12dp" />
        <TextView
            android:id="@+id/total"
            style="@style/ExValue"
            android:layout_width="0dp" android:layout_weight="1"
            android:gravity="end"
            android:textSize="18sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/app_accent" />
    </LinearLayout>
</LinearLayout>
