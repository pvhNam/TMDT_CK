<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context="com.example.tmdt.ui.auth.ForgotPasswordFragment">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ReferenceToolbar"
        app:title="@string/page_forgot" />
    <ScrollView
        android:id="@+id/account_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">
            <include
                layout="@layout/view_account_feedback" />
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="182dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/illustration_reset"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    style="@style/ReferenceTitle"
                    android:text="@string/reset_heading"
                    android:gravity="center" />
                <TextView
                    style="@style/ReferenceBody"
                    android:text="@string/reset_caption"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_layout"
                    style="@style/ReferenceFilledField"
                    app:startIconDrawable="@drawable/ic_field_email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        style="@style/ReferenceInput"
                        android:hint="@string/ref_email_hint"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress"
                        android:maxLength="254" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/send"
                    style="@style/ReferencePrimary"
                    android:text="@string/send_reset"
                    android:contentDescription="@string/send_reset" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_in"
                    style="@style/ReferenceOutline"
                    android:text="@string/back_login"
                    android:contentDescription="@string/back_login" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_account_note"
                    android:padding="16dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_field_shield"
                        app:tint="@color/account_blue"
                        android:importantForAccessibility="no"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        style="@style/ReferenceBody"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="@string/ref_reset_note"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>