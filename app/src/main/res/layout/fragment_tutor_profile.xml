<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Top Navigation Toolbar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/ib_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            app:tint="#06164D" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tutor_profile_title"
            android:textColor="#06164D"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/ib_favorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_heart"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tutor_profile_save" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/soft_border" />

    <!-- Not Found State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tutor_profile_not_found"
            android:textColor="#46638C"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_back"
            style="@style/PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/back" />
    </LinearLayout>

    <!-- Main Content in ScrollView -->
    <FrameLayout
        android:id="@+id/fl_main_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp">

                <!-- 1. Tutor Hero Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/soft_card_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="@color/soft_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <com.example.tmdt.ui.common.AvatarView
                            android:id="@+id/avatar"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="19sp"
                                android:textColor="#06164D"
                                android:fontFamily="sans-serif-medium"
                                tools:text="Nguyễn Minh Anh" />

                            <TextView
                                android:id="@+id/tv_verified_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tutor_profile_verified_badge"
                                android:textColor="#009D70"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium"
                                android:background="@drawable/bg_verified_pill"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:layout_marginTop="5dp" />

                            <TextView
                                android:id="@+id/tv_education"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="#46638C"
                                android:layout_marginTop="6dp"
                                tools:text="Đại học Sư phạm · Toán học" />

                            <TextView
                                android:id="@+id/tv_region"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="#46638C"
                                android:layout_marginTop="3dp"
                                tools:text="Khu vực: TP. Hồ Chí Minh" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Stats Bar (Rating, Experience, Students) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_pale"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginTop="12dp">

                    <!-- Stat 1: Rating -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_star"
                            android:contentDescription="@null"
                            app:tint="#FFB617" />

                        <TextView
                            android:id="@+id/tv_stat_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="17sp"
                            android:textColor="#06164D"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutor_profile_stat_rating"
                            android:textSize="12sp"
                            android:textColor="#46638C"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:background="@color/soft_border" />

                    <!-- Stat 2: Experience -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_cap"
                            android:contentDescription="@null"
                            app:tint="#006BFF" />

                        <TextView
                            android:id="@+id/tv_stat_experience"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="17sp"
                            android:textColor="#06164D"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutor_profile_stat_experience"
                            android:textSize="12sp"
                            android:textColor="#46638C"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:background="@color/soft_border" />

                    <!-- Stat 3: Students -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_users"
                            android:contentDescription="@null"
                            app:tint="#006BFF" />

                        <TextView
                            android:id="@+id/tv_stat_students"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="17sp"
                            android:textColor="#06164D"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutor_profile_stat_students"
                            android:textSize="12sp"
                            android:textColor="#46638C"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. Section: Giới thiệu -->
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/tutor_profile_section_intro"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/soft_field_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="@color/soft_border"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tv_introduction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:textSize="15sp"
                        android:textColor="#46638C"
                        android:lineSpacingExtra="4dp"
                        tools:text="Hướng dẫn dễ hiểu, bám sát mục tiêu và năng lực của học viên." />
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Section: Hình thức dạy -->
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/tutor_profile_section_modes"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Online Mode Card -->
                    <LinearLayout
                        android:id="@+id/card_mode_online"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_mode_card_active"
                        android:padding="14dp"
                        android:layout_marginEnd="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_mode_online"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_laptop"
                                app:tint="#006BFF"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_mode_online_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tutor_profile_mode_supported"
                                android:textSize="11sp"
                                android:textColor="#009D70"
                                android:background="@drawable/bg_verified_pill"
                                android:paddingStart="7dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_mode_online_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutor_profile_mode_online"
                            android:textSize="15sp"
                            android:textColor="#06164D"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutor_profile_mode_online_desc"
                            android:textSize="12sp"
                            android:textColor="#46638C"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Home Mode Card -->
                    <LinearLayout
                        android:id="@+id/card_mode_home"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_mode_card_active"
                        android:padding="14dp"
                        android:layout_marginStart="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_mode_home"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_home"
                                app:tint="#006BFF"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_mode_home_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tutor_profile_mode_supported"
                                android:textSize="11sp"
                                android:textColor="#009D70"
                                android:background="@drawable/bg_verified_pill"
                                android:paddingStart="7dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_mode_home_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutor_profile_mode_home"
                            android:textSize="15sp"
                            android:textColor="#06164D"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tutor_profile_mode_home_desc"
                            android:textSize="12sp"
                            android:textColor="#46638C"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 5. Section: Môn dạy & Học phí -->
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/tutor_profile_section_pricing"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/ll_offerings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_empty_offerings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tutor_profile_no_offerings"
                    android:textColor="#46638C"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:visibility="gone" />

                <!-- 6. Section: Đánh giá học viên -->
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/tutor_profile_section_reviews"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_reviews_summary_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tutor_profile_no_reviews"
                    android:textColor="#46638C"
                    android:textSize="14sp"
                    android:padding="16dp"
                    android:background="@drawable/bg_account_note"
                    android:layout_marginBottom="12dp" />
                <!-- Reviews list container -->
                <LinearLayout
                    android:id="@+id/ll_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/tutor_comments_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </ScrollView>

        <!-- Sticky Footer Action Bar -->
        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_message"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/tutor_profile_action_message"
                android:textColor="#006BFF"
                android:textSize="15sp"
                app:icon="@drawable/ic_chat"
                app:iconTint="#006BFF"
                app:iconSize="20dp"
                app:strokeColor="#006BFF"
                app:strokeWidth="1.5dp"
                app:cornerRadius="@dimen/soft_button_radius"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_book"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/tutor_profile_action_book"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="#006BFF"
                app:icon="@drawable/ic_calendar"
                app:iconTint="#FFFFFF"
                app:iconSize="20dp"
                app:cornerRadius="@dimen/soft_button_radius"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>