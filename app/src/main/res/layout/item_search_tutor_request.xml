<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="16dp" app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@android:color/white" app:strokeColor="#DDE4EF" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView style="@style/FieldLabel" android:text="@string/request_search_status_open"
            android:textColor="#236B42" android:textSize="13sp" />
        <TextView android:id="@+id/search_request_title" style="@style/ScreenTitle" android:textSize="20sp" />
        <TextView android:id="@+id/search_request_subject_level" style="@style/BodyText" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/search_request_budget" style="@style/FieldLabel" />
        <TextView android:id="@+id/search_request_schedule" style="@style/BodyText" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/search_request_description" style="@style/BodyText"
            android:maxLines="3" android:ellipsize="end" />
        <com.google.android.material.button.MaterialButton android:id="@+id/view_request_details"
            style="@style/PrimaryButton" android:text="@string/request_search_view_details" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
