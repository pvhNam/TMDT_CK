<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp"
    app:cardBackgroundColor="@color/app_surface" app:strokeColor="@color/app_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView style="@style/FieldLabel" android:text="@string/request_search_status_open"
            android:textColor="@color/app_success" android:textSize="12sp" android:layout_marginBottom="10dp" />
        <TextView android:id="@+id/search_request_title" style="@style/ScreenTitle" android:textSize="17sp"
            android:fontFamily="sans-serif-medium" android:layout_marginBottom="6dp" />
        <TextView android:id="@+id/search_request_subject_level" style="@style/BodyText"
            android:textSize="13sp" android:layout_marginBottom="12dp" />
        <TextView android:id="@+id/search_request_budget" style="@style/FieldLabel"
            android:textColor="@color/app_accent" android:textSize="16sp" android:layout_marginBottom="10dp" />
        <TextView android:id="@+id/search_request_schedule" style="@style/BodyText"
            android:textSize="13sp" android:layout_marginBottom="6dp" />
        <TextView android:id="@+id/search_request_description" style="@style/BodyText"
            android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:layout_marginBottom="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/view_request_details"
            style="@style/RequestManageAction" android:text="@string/request_search_view_details"
            android:textColor="@color/app_accent" app:backgroundTint="@color/app_surface_variant"
            app:strokeWidth="0dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
