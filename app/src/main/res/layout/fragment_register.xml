<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context="com.example.tmdt.ui.auth.RegisterFragment">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ReferenceToolbar"
        app:title="@string/page_register" />
    <ScrollView
        android:id="@+id/account_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">
            <include
                layout="@layout/view_account_feedback" />
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    style="@style/ReferenceTitle"
                    android:text="@string/register_heading"
                    android:textSize="20sp" />
                <TextView
                    style="@style/ReferenceBody"
                    android:text="@string/register_caption"
                    android:layout_marginBottom="16dp" />
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/name"
                    android:labelFor="@id/name" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/name_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_user">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name"
                        style="@style/ReferenceInput"
                        android:hint="@string/name"
                        android:inputType="textCapWords"
                        android:autofillHints="personName"
                        android:maxLength="100" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/email"
                    android:labelFor="@id/email" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        style="@style/ReferenceInput"
                        android:hint="@string/ref_email_hint"
                        android:inputType="textEmailAddress"
                        android:autofillHints="emailAddress"
                        android:maxLength="254" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/phone"
                    android:labelFor="@id/phone" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phone_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_phone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone"
                        style="@style/ReferenceInput"
                        android:hint="@string/ref_phone_hint"
                        android:inputType="phone"
                        android:autofillHints="phoneNumber"
                        android:maxLength="20" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/password"
                    android:labelFor="@id/password" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_lock"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        style="@style/ReferenceInput"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:maxLength="128" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    style="@style/ReferenceLabel"
                    android:text="@string/confirm_password"
                    android:labelFor="@id/confirm" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirm_layout"
                    style="@style/ReferenceField"
                    app:startIconDrawable="@drawable/ic_field_lock"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirm"
                        style="@style/ReferenceInput"
                        android:hint="@string/confirm_password"
                        android:inputType="textPassword"
                        android:autofillHints="newPassword"
                        android:maxLength="128" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <CheckBox
                        android:id="@+id/terms"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:buttonTint="@color/account_ink"
                        android:contentDescription="@string/accept_terms" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/terms_info"
                        style="@style/ReferenceLink"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="start|center_vertical"
                        android:text="@string/ref_terms"
                        android:contentDescription="@string/terms_link"
                        android:textSize="11sp"
                        android:paddingStart="0dp"
                        android:maxLines="3" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register"
                    style="@style/ReferencePrimary"
                    android:text="@string/create_account"
                    android:contentDescription="@string/create_account" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_in"
                    style="@style/ReferenceFooter"
                    android:text="@string/ref_login_footer"
                    android:contentDescription="@string/login_link"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>