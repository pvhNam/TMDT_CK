<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pull_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.example.tmdt.ui.home.HomeFragment">
    <ScrollView android:id="@+id/home_scroll" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/greeting"
                style="@style/BodyText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/greeting" />
            <com.example.tmdt.ui.common.AvatarView
                android:id="@+id/account"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/personal_info" />
        </LinearLayout>
        <TextView
            style="@style/ScreenTitle"
            android:text="@string/home_heading"
            android:labelFor="@id/search" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/search"
                style="@style/FormInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="0dp"
                android:hint="@string/search_hint"
                android:contentDescription="@string/search_description"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/search_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="13dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/search_button"
                android:tooltipText="@string/search_button"
                app:backgroundTint="@color/theme_fill_f5f8ff"
                app:cornerRadius="18dp"
                app:strokeColor="@color/theme_border_e1eafa"
                app:strokeWidth="1dp"
                app:icon="@drawable/search"
                app:iconSize="26dp"
                app:iconTint="@null"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:rippleColor="@color/theme_fill_dcebff" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/subjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
        <LinearLayout
            android:id="@+id/group_classes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="-6dp"
            android:layout_marginEnd="-6dp"
            android:paddingHorizontal="6dp"
            android:paddingTop="4dp"
            android:clipToPadding="false"
            android:orientation="vertical" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">
            <TextView
                style="@style/SectionTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="@string/catalog_heading" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/refresh"
                style="@style/TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:paddingHorizontal="8dp"
                android:text="@string/refresh_short"
                android:contentDescription="@string/refresh_catalog" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading_catalog" />
        <TextView
            android:id="@+id/offline"
            style="@style/BodyText"
            android:text="@string/offline_catalog" />
        <TextView
            android:id="@+id/message"
            style="@style/SectionTitle"
            android:text="@string/empty_catalog" />
        <TextView
            android:id="@+id/description"
            style="@style/BodyText"
            android:text="@string/empty_catalog_caption" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            style="@style/SecondaryButton"
            android:text="@string/retry"
            android:contentDescription="@string/retry" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_search"
            style="@style/SecondaryButton"
            android:text="@string/clear_search"
            android:contentDescription="@string/clear_search" />
        <LinearLayout
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="120dp"
            android:paddingHorizontal="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:orientation="vertical">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/results_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:id="@+id/pager_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/pager_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="10dp"
                    android:rotation="180"
                    android:background="@drawable/bg_pale"
                    android:src="@drawable/ic_right"
                    app:tint="@color/theme_text_0866f5"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/previous_tutors" />
                <LinearLayout
                    android:id="@+id/pager_dots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/pager_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_pale"
                    android:src="@drawable/ic_right"
                    app:tint="@color/theme_text_0866f5"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/next_tutors" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
