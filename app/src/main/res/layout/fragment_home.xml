<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pull_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.example.tmdt.ui.home.HomeFragment">
    <ScrollView android:id="@+id/home_scroll" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/greeting"
                style="@style/BodyText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/greeting" />
            <com.example.tmdt.ui.common.AvatarView
                android:id="@+id/account"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/personal_info" />
        </LinearLayout>
        <TextView
            style="@style/ScreenTitle"
            android:text="@string/home_heading"
            android:labelFor="@id/search" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/search"
                style="@style/FormInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="0dp"
                android:hint="@string/search_hint"
                android:contentDescription="@string/search_description"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/search_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="13dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/search_button"
                android:tooltipText="@string/search_button"
                app:backgroundTint="@color/theme_fill_f5f8ff"
                app:cornerRadius="18dp"
                app:strokeColor="@color/theme_border_e1eafa"
                app:strokeWidth="1dp"
                app:icon="@drawable/search"
                app:iconSize="26dp"
                app:iconTint="@null"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:rippleColor="@color/theme_fill_dcebff" />
        </LinearLayout>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/subjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
        <LinearLayout
            android:id="@+id/group_classes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pale"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_users"
                app:tint="@color/theme_text_0866f5"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginBottom="2dp"
                    android:text="@string/group_classes_heading" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/theme_text_4d6287"
                    android:text="@string/group_classes_caption" />
            </LinearLayout>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_right"
                app:tint="@color/theme_text_081f50"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/post_tutor_request"
            style="@style/PrimaryButton"
            android:text="@string/request_heading" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/manage_tutor_requests"
            style="@style/SecondaryButton"
            android:text="@string/manage_requests_title" />
        <TextView
            style="@style/BodyText"
            android:layout_marginTop="6dp"
            android:text="@string/request_caption" />
        <TextView
            style="@style/SectionTitle"
            android:text="@string/catalog_heading" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh"
            style="@style/TextButton"
            android:text="@string/refresh_catalog"
            android:contentDescription="@string/refresh_catalog" />
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading_catalog" />
        <TextView
            android:id="@+id/offline"
            style="@style/BodyText"
            android:text="@string/offline_catalog" />
        <TextView
            android:id="@+id/message"
            style="@style/SectionTitle"
            android:text="@string/empty_catalog" />
        <TextView
            android:id="@+id/description"
            style="@style/BodyText"
            android:text="@string/empty_catalog_caption" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            style="@style/SecondaryButton"
            android:text="@string/retry"
            android:contentDescription="@string/retry" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_search"
            style="@style/SecondaryButton"
            android:text="@string/clear_search"
            android:contentDescription="@string/clear_search" />
        <LinearLayout
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
