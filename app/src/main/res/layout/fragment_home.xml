<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.example.tmdt.ui.home.HomeFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/greeting"
                style="@style/BodyText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/greeting" />
            <ImageButton
                android:id="@+id/account"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_person"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/personal_info" />
        </LinearLayout>
        <TextView
            style="@style/ScreenTitle"
            android:text="@string/home_heading"
            android:labelFor="@id/search" />
        <EditText
            android:id="@+id/search"
            style="@style/FormInput"
            android:layout_marginTop="16dp"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/subjects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pale"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/banner_heading" />
                <TextView
                    style="@style/BodyText"
                    android:text="@string/banner_caption" />
            </LinearLayout>
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_cap"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView
            style="@style/SectionTitle"
            android:text="@string/catalog_heading" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh"
            style="@style/TextButton"
            android:text="@string/refresh_catalog"
            android:contentDescription="@string/refresh_catalog" />
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading_catalog" />
        <TextView
            android:id="@+id/offline"
            style="@style/BodyText"
            android:text="@string/offline_catalog" />
        <TextView
            android:id="@+id/message"
            style="@style/SectionTitle"
            android:text="@string/empty_catalog" />
        <TextView
            android:id="@+id/description"
            style="@style/BodyText"
            android:text="@string/empty_catalog_caption" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            style="@style/SecondaryButton"
            android:text="@string/retry"
            android:contentDescription="@string/retry" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_filter"
            style="@style/SecondaryButton"
            android:text="@string/clear_filter"
            android:contentDescription="@string/clear_filter" />
        <LinearLayout
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>