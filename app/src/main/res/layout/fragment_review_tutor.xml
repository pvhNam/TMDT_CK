<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context="com.example.tmdt.ui.profile.ReviewTutorFragment">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ReferenceToolbar"
        app:titleTextAppearance="@style/TutorToolbarTitle"
        app:title="@string/tutor_register" />
    <ScrollView
        android:id="@+id/account_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">
            <include
                layout="@layout/view_account_feedback" />
            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include
                    android:id="@+id/steps"
                    layout="@layout/view_tutor_steps" />
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/tutor_review_title"
                    android:textSize="23sp"
                    android:layout_marginBottom="16dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="133dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_tutor_field"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">
                    <include
                        android:id="@+id/avatar"
                        layout="@layout/view_avatar"
                        android:layout_width="97dp"
                        android:layout_height="113dp"
                        android:layout_marginBottom="0dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">
                        <TextView
                            android:id="@+id/name"
                            style="@style/TutorLabel"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/subjects"
                            style="@style/TutorText"
                            android:textSize="15sp"
                            android:textColor="@color/tutor_muted"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:id="@+id/mode"
                            style="@style/TutorText"
                            android:textSize="15sp"
                            android:textColor="#009D70" />
                        <TextView
                            android:id="@+id/price"
                            style="@style/TutorLabel"
                            android:textSize="17sp"
                            android:textColor="@color/tutor_blue"
                            android:layout_marginBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/phone"
                    android:labelFor="@id/phone" />
                <TextView
                    android:id="@+id/phone"
                    style="@style/TutorText"
                    android:layout_marginBottom="16dp" />
                <TextView
                    style="@style/TutorLabel"
                    android:text="@string/tutor_experience"
                    android:labelFor="@id/experience" />
                <TextView
                    android:id="@+id/experience"
                    style="@style/TutorText"
                    android:layout_marginBottom="24dp" />
                <TextView
                    android:id="@+id/review_note"
                    style="@style/TutorText"
                    android:text="@string/tutor_review_note"
                    android:padding="12dp"
                    android:background="@drawable/bg_tutor_surface"
                    android:drawablePadding="12dp"
                    android:textSize="14sp"
                    android:textColor="@color/tutor_muted"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp" />
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textSize="15sp"
                    android:textColor="@color/tutor_ink"
                    android:text="@string/tutor_confirm"
                    android:layout_marginBottom="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submit"
                    style="@style/TutorPrimary"
                    android:text="@string/tutor_send" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_again"
                    style="@style/TutorOutline"
                    android:text="@string/tutor_edit_again" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>