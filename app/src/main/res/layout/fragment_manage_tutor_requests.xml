<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/ReferenceToolbar"
        android:background="@color/app_background"
        app:title="@string/requests_heading" />

    <ScrollView
        android:id="@+id/requests_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView
                    android:id="@+id/requests_section_title"
                    style="@style/FieldLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:accessibilityHeading="true"
                    android:textColor="@color/app_ink"
                    android:textSize="16sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/create_request"
                    style="@style/RequestManagePrimary"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/requests_create_short"
                    app:icon="@drawable/ic_ex_plus"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/request_tabs"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/app_accent"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="2dp"
                app:tabMinWidth="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@color/request_manage_pale"
                app:tabSelectedTextColor="@color/request_manage_blue"
                app:tabTextAppearance="@style/SectionTabText"
                app:tabTextColor="@color/request_manage_muted" />

            <TextView
                android:id="@+id/requests_offline"
                style="@style/RequestManageBody"
                android:layout_marginBottom="12dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_request_manage_pill"
                android:padding="14dp"
                android:text="@string/requests_offline"
                android:visibility="gone" />

            <TextView
                android:id="@+id/requests_error"
                style="@style/RequestManageBody"
                android:layout_marginBottom="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/request_manage_red"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_requests"
                style="@style/RequestManageAction"
                android:layout_marginBottom="12dp"
                android:text="@string/requests_retry"
                android:visibility="gone" />

            <TextView
                android:id="@+id/requests_notice"
                style="@style/RequestManageBody"
                android:layout_marginBottom="12dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/request_manage_green"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/requests_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/requests_loading"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/requests_empty_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/app_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_request_manage_pill"
                        android:importantForAccessibility="no"
                        android:padding="19dp"
                        android:src="@drawable/ic_file"
                        app:tint="@color/request_manage_blue" />

                    <TextView
                        android:id="@+id/requests_empty_title"
                        style="@style/FieldLabel"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:textColor="@color/request_manage_ink"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/requests_empty"
                        style="@style/RequestManageBody"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/requests_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
