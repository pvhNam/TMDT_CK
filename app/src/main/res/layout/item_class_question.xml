<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="14dp" app:strokeWidth="1dp" app:strokeColor="#DDE4EF" app:cardElevation="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/class_question_author" style="@style/FieldLabel" android:textSize="16sp" android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/class_question_tutor_badge" style="@style/BodyText" android:text="@string/class_questions_tutor_badge"
            android:textColor="#236B42" android:textSize="12sp" android:layout_marginBottom="4dp" android:visibility="gone" />
        <TextView android:id="@+id/class_question_date" style="@style/BodyText" android:textSize="12sp" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/class_question_content" style="@style/BodyText" android:textColor="#081F50"
            android:textIsSelectable="true" android:layout_marginBottom="6dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/reply_to_class_question" style="@style/TextButton"
            android:text="@string/class_questions_reply" android:minHeight="44dp" />
        <LinearLayout android:id="@+id/class_question_replies_container" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="0dp" android:visibility="gone">
            <ProgressBar android:id="@+id/class_question_replies_progress" android:layout_width="28dp" android:layout_height="28dp"
                android:contentDescription="@string/class_questions_loading" android:visibility="gone" />
            <TextView android:id="@+id/class_question_replies_error" style="@style/BodyText" android:textColor="#B3261E"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/retry_class_question_replies" style="@style/SecondaryButton"
                android:text="@string/class_questions_retry" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/class_question_load_more_replies" style="@style/TextButton"
                android:text="@string/class_questions_load_more_replies" android:visibility="gone" />
            <TextView android:id="@+id/class_question_replies_empty" style="@style/BodyText" android:text="@string/class_questions_reply_empty"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/class_question_replies_list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
