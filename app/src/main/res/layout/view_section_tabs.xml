<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.tabs.TabLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/section_tabs"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_section_tab_track"
    android:paddingHorizontal="4dp"
    app:tabGravity="fill"
    app:tabIndicator="@drawable/bg_section_tab_selected"
    app:tabIndicatorAnimationDuration="220"
    app:tabIndicatorColor="@color/app_surface"
    app:tabIndicatorFullWidth="true"
    app:tabIndicatorGravity="stretch"
    app:tabMinWidth="0dp"
    app:tabMode="fixed"
    app:tabPaddingStart="8dp"
    app:tabPaddingEnd="8dp"
    app:tabRippleColor="@color/app_surface_variant"
    app:tabSelectedTextColor="@color/app_accent"
    app:tabTextAppearance="@style/SectionTabText"
    app:tabTextColor="@color/app_muted" />
