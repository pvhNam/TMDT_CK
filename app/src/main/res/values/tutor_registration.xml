    <style
        name="TutorText"
        parent="ReferenceBody">
        <item
            name="android:fontFamily">sans-serif-condensed</item>
        <item
            name="android:textSize">16sp</item>
        <item
            name="android:textColor">@color/tutor_ink</item>
        <item
            name="android:layout_marginBottom">0dp</item>
    </style>
    <style
        name="TutorLabel"
        parent="ReferenceLabel">
        <item
            name="android:fontFamily">sans-serif-condensed</item>
        <item
            name="android:textSize">16sp</item>
        <item
            name="android:textColor">@color/tutor_ink</item>
        <item
            name="android:layout_marginBottom">7dp</item>
    </style>
    <style
        name="TutorInput"
        parent="FormInput">
        <item
            name="android:fontFamily">sans-serif-condensed</item>
        <item
            name="android:textSize">16sp</item>
        <item
            name="android:minHeight">48dp</item>
        <item
            name="android:padding">14dp</item>
        <item
            name="android:paddingTop">8dp</item>
        <item
            name="android:paddingBottom">8dp</item>
        <item
            name="android:layout_marginBottom">10dp</item>
        <item
            name="android:background">@drawable/bg_tutor_field</item>
        <item
            name="android:textColor">@color/tutor_ink</item>
        <item
            name="android:textColorHint">@color/tutor_muted</item>
    </style>
    <style
        name="TutorPrimary"
        parent="ReferencePrimary">
        <item
            name="android:fontFamily">sans-serif-condensed</item>
        <item
            name="android:textSize">18sp</item>
        <item
            name="cornerRadius">@dimen/soft_button_radius</item>
        <item
            name="backgroundTint">@color/tutor_blue</item>
    </style>
    <style
        name="TutorOutline"
        parent="ReferenceOutline">
        <item
            name="android:fontFamily">sans-serif-condensed</item>
        <item
            name="android:textSize">18sp</item>
        <item
            name="android:textStyle">bold</item>
        <item
            name="cornerRadius">@dimen/soft_button_radius</item>
        <item
            name="strokeColor">@color/tutor_blue</item>
        <item
            name="android:textColor">@color/tutor_blue</item>
    </style>
    <style
        name="TutorToolbarTitle"
        parent="ReferenceToolbarTitle">
        <item
            name="android:fontFamily">sans-serif-condensed</item>
        <item
            name="android:textSize">22sp</item>
        <item
            name="android:textColor">@color/tutor_ink</item>
    </style>
    <style
        name="TutorMode"
        parent="Widget.Material3.Button.OutlinedButton">
        <item
            name="android:layout_width">0dp</item>
        <item
            name="android:layout_height">48dp</item>
        <item
            name="android:layout_weight">1</item>
        <item
            name="android:fontFamily">sans-serif-condensed</item>
        <item
            name="android:textSize">16sp</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="android:paddingLeft">12dp</item>
        <item
            name="android:paddingRight">8dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="cornerRadius">@dimen/soft_button_radius</item>
        <item
            name="iconSize">25dp</item>
        <item
            name="iconPadding">10dp</item>
        <item
            name="iconTint">@null</item>
    </style>
</resources>