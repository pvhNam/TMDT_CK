<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="ScreenTitle">
        <item
            name="android:layout_width">match_parent</item>
        <item
            name="android:layout_height">wrap_content</item>
        <item
            name="android:textSize">26sp</item>
        <item
            name="android:textColor">#081F50</item>
        <item
            name="android:fontFamily">sans-serif-medium</item>
        <item
            name="android:layout_marginBottom">8dp</item>
    </style>
    <style
        name="SectionTitle"
        parent="ScreenTitle">
        <item
            name="android:textSize">19sp</item>
        <item
            name="android:layout_marginTop">16dp</item>
        <item
            name="android:layout_marginBottom">12dp</item>
    </style>
    <style
        name="FieldLabel">
        <item
            name="android:layout_width">match_parent</item>
        <item
            name="android:layout_height">wrap_content</item>
        <item
            name="android:textSize">14sp</item>
        <item
            name="android:textColor">#081F50</item>
        <item
            name="android:fontFamily">sans-serif-medium</item>
        <item
            name="android:layout_marginBottom">6dp</item>
    </style>
    <style
        name="BodyText">
        <item
            name="android:layout_width">match_parent</item>
        <item
            name="android:layout_height">wrap_content</item>
        <item
            name="android:textSize">14sp</item>
        <item
            name="android:textColor">#4D6287</item>
        <item
            name="android:layout_marginBottom">16dp</item>
    </style>
    <style
        name="FormInput">
        <item
            name="android:layout_width">match_parent</item>
        <item
            name="android:layout_height">wrap_content</item>
        <item
            name="android:minHeight">50dp</item>
        <item
            name="android:padding">13dp</item>
        <item
            name="android:layout_marginBottom">16dp</item>
        <item
            name="android:textSize">15sp</item>
        <item
            name="android:textColor">#081F50</item>
        <item
            name="android:textColorHint">#4D6287</item>
        <item
            name="android:fontFamily">sans-serif</item>
        <item
            name="android:background">@drawable/bg_input</item>
        <item
            name="android:singleLine">true</item>
        <item
            name="android:saveEnabled">false</item>
    </style>
    <style
        name="PrimaryButton"
        parent="Widget.Material3.Button">
        <item
            name="android:layout_width">match_parent</item>
        <item
            name="android:layout_height">wrap_content</item>
        <item
            name="android:minHeight">54dp</item>
        <item
            name="android:layout_marginTop">8dp</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="cornerRadius">12dp</item>
    </style>
    <style
        name="SecondaryButton"
        parent="Widget.Material3.Button.OutlinedButton">
        <item
            name="android:layout_width">match_parent</item>
        <item
            name="android:layout_height">wrap_content</item>
        <item
            name="android:minHeight">50dp</item>
        <item
            name="android:layout_marginTop">6dp</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="cornerRadius">12dp</item>
    </style>
    <style
        name="TextButton"
        parent="Widget.Material3.Button.TextButton">
        <item
            name="android:layout_width">match_parent</item>
        <item
            name="android:layout_height">wrap_content</item>
        <item
            name="android:minHeight">48dp</item>
        <item
            name="android:textAllCaps">false</item>
    </style>
    <style
        name="ProfileValue"
        parent="BodyText">
        <item
            name="android:textColor">#081F50</item>
        <item
            name="android:textSize">16sp</item>
    </style>
</resources>