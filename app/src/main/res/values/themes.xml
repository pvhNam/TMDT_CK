<resources>
    <style name="Base.Theme.TMDT" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#0866F5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_ink</item>
        <item name="colorOnSurfaceVariant">@color/app_muted</item>
        <item name="android:textColorPrimary">@color/app_ink</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
        <item name="android:textColorHint">@color/app_muted</item>
        <item name="colorControlNormal">@color/app_muted</item>
        <item name="colorControlActivated">@color/app_accent</item>
        <item name="colorError">@color/app_error</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TMDT.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.TMDT.Dialog</item>
        <item name="colorOnBackground">@color/app_ink</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOutline">@color/app_border</item>
        <item name="colorSecondary">#0866F5</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TMDT.SoftSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TMDT.SoftMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TMDT.SoftLarge</item>
        <item name="colorSecondaryContainer">@color/soft_surface</item>
        <item name="colorOnSecondaryContainer">@color/app_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/app_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/app_light_system_bars</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.TMDT" parent="Base.Theme.TMDT" />
    <style name="ThemeOverlay.TMDT.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_ink</item>
        <item name="android:windowBackground">@drawable/bg_classroom_dialog</item>
        <item name="android:textColorPrimary">@color/app_ink</item>
        <item name="android:textColorSecondary">@color/app_muted</item>
    </style>
</resources>
