<?xml version="1.0" encoding="utf-8"?>
<resources>
    <item name="open_group_assignments" type="id" />
    <style name="AssignmentBody" parent="BodyText">
        <item name="android:textColor">@color/app_muted</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="AssignmentLabel" parent="FieldLabel">
        <item name="android:textColor">@color/app_ink</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="AssignmentInput" parent="FormInput">
        <item name="android:textColor">@color/app_ink</item>
        <item name="android:textColorHint">@color/app_muted</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="AssignmentPrimary" parent="PrimaryButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="AssignmentSecondary" parent="SecondaryButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/app_accent</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="strokeColor">@color/app_border</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <item name="assignment_review_score" type="id" />
    <item name="assignment_review_feedback" type="id" />
    <item name="assignment_review_save" type="id" />
</resources>
